    <add key="AllowedCorsOrigins" value="https://helpdesk.desipr.com.mx" />
    <add key="client_id" value="ServiceDeskDESIMVC" />
    <add key="client_secret" value="ServiceDeskDESI_2026_S3cr3t" />

    <!-- Configuración de evidencias de tickets (fuente de verdad para MVC) -->
    <add key="EvidenciasMaxArchivos" value="3" />
    <add key="EvidenciasMaxTamanoMB" value="3" />
    <add key="EvidenciasExtensionesPermitidas" value="pdf,jpg,png" />
  </appSettings>
  <system.web>
    <compilation debug="false" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" maxRequestLength="15360" />
    <!-- machineKey fija (misma que el MVC): sin ella, cada reciclaje del AppPool genera
         una clave nueva y los tokens OAuth emitidos dejan de poder descifrarse (401),
         causando sesiones "perdidas" (dashboard/menús vacíos y luego AccesoDenegado). -->
    <machineKey validationKey="575fca61c1341aa4602e685ceec9967ea5a41b14fb913eb4b801ac4d54f802fc46250334cb0fa56b9739c9bf991c197ec217c2396b8f8ac451a8b3b4ca2cdd08" decryptionKey="d2eef882d12790c4b743922e9389f31ffa3ba823c103b16f7b4be3d75e31e31c" validation="SHA1" decryption="AES" />
  </system.web>
