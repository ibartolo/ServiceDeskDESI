    <add name="sConSqlPrd" connectionString="Data Source=sql8005.site4now.net;Initial Catalog=db_9c7990_helpdeskdesi;User Id=db_9c7990_helpdeskdesi_admin;Password=Ifbc121290.01@;Encrypt=True;TrustServerCertificate=True;" />
