<?xml version="1.0"?>
<!--
  For more information on how to configure your ASP.NET application, please visit
  https://go.microsoft.com/fwlink/?LinkId=301880
  -->
<configuration>
  <appSettings>
    <add key="webpages:Version" value="3.0.0.0"/>
    <add key="webpages:Enabled" value="false"/>
    <add key="ClientValidationEnabled" value="true"/>
    <add key="UnobtrusiveJavaScriptEnabled" value="true"/>
    <!-- Valores locales (dev), comentados por si se requieren:
    <add key="BaseUri" value="http://localhost:63888/"/>
    <add key="BaseUriWebApi" value="http://localhost:44357/"/> -->
    <add key="BaseUri" value="https://helpdesk.desipr.com.mx/"/>
    <add key="BaseUriWebApi" value="https://helpdeskwebapi.desipr.com.mx/"/>
    <!-- Desactivar descubrimiento automático de OWIN en esta aplicación MVC -->
    <add key="owin:AutomaticAppStartup" value="false"/>
    <!-- client_id / client_secret: cliente OAuth único (el MVC). Deben coincidir con los del WebApi. -->
    <add key="client_id" value="ServiceDeskDESIMVC"/>
    <add key="client_secret" value="ServiceDeskDESI_2026_S3cr3t"/>
  </appSettings>
  <system.web>
    <customErrors mode="Off"/>
    <compilation debug="true" targetFramework="4.8"/>
    <httpRuntime targetFramework="4.8" maxRequestLength="15360"/>
    <authentication mode="Forms">
      <forms name="autentication" cookieless="UseCookies" protection="All"/>
    </authentication>
    <!-- machineKey fija: sin ella, cada reciclaje del AppPool genera una clave nueva y
         la cookie de autenticación (FormsAuthentication) deja de poder descifrarse,
         por lo que la sesión "se pierde" y el menú muestra la pantalla de login. -->
    <machineKey validationKey="575fca61c1341aa4602e685ceec9967ea5a41b14fb913eb4b801ac4d54f802fc46250334cb0fa56b9739c9bf991c197ec217c2396b8f8ac451a8b3b4ca2cdd08" decryptionKey="d2eef882d12790c4b743922e9389f31ffa3ba823c103b16f7b4be3d75e31e31c" validation="SHA1" decryption="AES" />
  </system.web>
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="Microsoft.Web.Infrastructure" publicKeyToken="31bf3856ad364e35"/>
        <bindingRedirect oldVersion="0.0.0.0-2.0.0.0" newVersion="2.0.0.0"/>
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Web.Helpers" publicKeyToken="31bf3856ad364e35"/>
        <bindingRedirect oldVersion="1.0.0.0-3.0.0.0" newVersion="3.0.0.0"/>
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Web.WebPages" publicKeyToken="31bf3856ad364e35"/>
        <bindingRedirect oldVersion="1.0.0.0-3.0.0.0" newVersion="3.0.0.0"/>
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Web.Mvc" publicKeyToken="31bf3856ad364e35"/>
        <bindingRedirect oldVersion="1.0.0.0-5.3.0.0" newVersion="5.3.0.0"/>
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="Newtonsoft.Json" publicKeyToken="30ad4fe6b2a6aeed" culture="neutral"/>
        <bindingRedirect oldVersion="0.0.0.0-13.0.0.0" newVersion="13.0.0.0"/>
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="Microsoft.Owin" publicKeyToken="31bf3856ad364e35" culture="neutral"/>
        <bindingRedirect oldVersion="0.0.0.0-4.2.3.0" newVersion="4.2.3.0"/>
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="Serilog" publicKeyToken="24c2f752a8e58a10" culture="neutral"/>
