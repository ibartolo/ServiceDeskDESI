
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Service Desk DESI - Iniciar Sesión</title>

    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Font Awesome 6 -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- SweetAlert2 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css" rel="stylesheet">
    <link href="~/CSS/Comun/TempAutentication.css" rel="stylesheet" />
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="~/Scripts/Comun/Comun.js"></script>

</head>
<body>
    <div class="login-container">
        <!-- Encabezado -->
        <div class="login-header">
            <i class="fas fa-headset"></i>
            <h2>Service Desk DESI</h2>
            <p>Sistema de Gestión de Tickets</p>
        </div>

        <!-- Cuerpo del login -->
        <div class="login-body">
            <!-- Mensaje de alerta (opcional) -->
            <div class="alert-message" id="alertMessage" style="display: none;">
                <i class="fas fa-exclamation-triangle"></i>
                <span id="alertText">Credenciales incorrectas. Intente nuevamente.</span>
            </div>

            <!-- Formulario de login -->
            <form id="loginForm">
                <!-- Campo de usuario/email -->
                <div class="form-group">
                    <label class="form-label">
                        <i class="fas fa-user me-2"></i>Usuario o Correo Electrónico
                    </label>
                    <div class="input-group">
                        <span class="input-group-text">
                            <i class="fas fa-envelope"></i>
                        </span>
                        <input type="text" class="form-control" id="username" required placeholder="Ingresa tu usuario">
                    </div>
                </div>

                <!-- Campo de contraseña -->
                <div class="form-group">
                    <label class="form-label">
                        <i class="fas fa-lock me-2"></i>Contraseña
                    </label>
                    <div class="input-group">
                        <span class="input-group-text">
                            <i class="fas fa-key"></i>
                        </span>
                        <input type="password" class="form-control" id="password" placeholder="Ingrese su contraseña" required>
                        <span class="password-toggle" id="togglePassword">
                            <i class="fas fa-eye"></i>
                        </span>
                    </div>
                </div>

                <!-- Recordar contraseña y olvidé mi contraseña -->
                <div class="remember-forgot">
                    <div class="remember-me">
                        <input type="checkbox" id="remember">
                        <label for="remember">Recordar mi usuario</label>
                    </div>
                    <a href="#" class="forgot-password" id="forgotPassword">
                        ¿Olvidaste tu contraseña?
                    </a>
                </div>

                <!-- Botón de inicio de sesión -->
                <button type="submit" class="btn-login">
                    <i class="fas fa-sign-in-alt"></i>
                    Iniciar Sesión
                </button>

                <!-- Enlace para registro (opcional)
    <div class="login-footer">
        <p>¿No tienes una cuenta? <a href="#" id="registerLink">Solicitar acceso</a></p>
    </div>-->
                <!-- Características del sistema -->
                <div class="features">
                    <div class="feature">
                        <i class="fas fa-ticket-alt"></i>
                        <span>Gestión de Tickets</span>
                    </div>
                    <div class="feature">
                        <i class="fas fa-chart-line"></i>
                        <span>Reportes en Tiempo Real</span>
                    </div>
                    <div class="feature">
                        <i class="fas fa-headset"></i>
                        <span>Soporte 24/7</span>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- ========================================= -->
    <!-- SCRIPTS -->
    <!-- ========================================= -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/Scripts/Comun/TempAutentication.js"></script>
    
</body>
</html>