@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Recuperar Contraseña - Service Desk DESI</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <link href="~/CSS/Comun/TemplateReciverPass.css" rel="stylesheet" />
    <script src="~/Scripts/Comun/Comun.js"></script>
</head>
<body>
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-6">
                <div class="card">
                    <div class="card-header">
                        <i class="fas fa-key"></i>
                        <h3 class="mb-0">Recuperar Contraseña</h3>
                        <p class="mb-0 mt-2">Establece una nueva contraseña</p>
                    </div>
                    <div class="card-body">
                        <div id="infoUsuario" class="info-usuario" style="display: none;">
                            <p><i class="fas fa-user"></i> <strong>Usuario:</strong> <span id="spanNombreUsuario"></span></p>
                            <p><i class="fas fa-user-circle"></i> <strong>Nombre:</strong> <span id="spanNombre"></span> <span id="spanApellido"></span></p>
                            <p><i class="fas fa-envelope"></i> <strong>Correo:</strong> <span id="spanCorreo"></span></p>
                        </div>

                        <form id="frmRecuperar">
                            <div class="mb-3">
                                <label for="nuevaContrasena" class="form-label">Nueva Contraseña</label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="fas fa-lock"></i></span>
                                    <input type="password" class="form-control" id="nuevaContrasena" name="nuevaContrasena" placeholder="Ingrese nueva contraseña">
                                    <button class="btn btn-outline-secondary" type="button" id="togglePassword">
                                        <i class="fas fa-eye"></i>
                                    </button>
                                </div>
                            </div>

                            <div class="mb-3">
                                <label for="confirmarContrasena" class="form-label">Confirmar Contraseña</label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="fas fa-check-circle"></i></span>
                                    <input type="password" class="form-control" id="confirmarContrasena" name="confirmarContrasena" placeholder="Confirme su nueva contraseña">
                                </div>
                            </div>

                            <ul class="requisitos" id="requisitos">
                                <li id="reqLongitud"><i class="fas fa-circle"></i> Mínimo 6 caracteres</li>
                                <li id="reqMayuscula"><i class="fas fa-circle"></i> Al menos una mayúscula</li>
                                <li id="reqMinuscula"><i class="fas fa-circle"></i> Al menos una minúscula</li>
                                <li id="reqNumero"><i class="fas fa-circle"></i> Al menos un número</li>
                                <li id="reqEspecial"><i class="fas fa-circle"></i> Al menos un carácter especial (!@@#$%^&*)</li>
                            </ul>

                            <div class="d-grid gap-2">
                                <input type="button" class="btn btn-primary" id="btnGuardar" onclick="GuardarNuevaContrasena()" value="Guardar Contraseña" />
                                <a href='@Url.Action("Autentication", "Home")' class="btn btn-secondary text-center" id="btnRegresar">Regresar</a>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
    const token = '@ViewBag.Token';
    </script>
    <script src="~/Scripts/Comun/RecoverPass.js"></script>
</body>
</html>