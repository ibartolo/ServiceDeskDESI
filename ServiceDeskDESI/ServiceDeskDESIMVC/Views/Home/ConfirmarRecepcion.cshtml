@{
    Layout = null;

    dynamic resultado = ViewBag.Resultado;
    bool esExito = false;
    bool yaConfirmado = false;
    string mensaje = "Enlace de confirmación no válido o ha sido alterado.";

    if (resultado != null)
    {
        esExito = resultado.IsSuccess == true;

        if (resultado.Message != null)
        {
            mensaje = (string)resultado.Message;
        }

        if (resultado.Response != null)
        {
            yaConfirmado = Convert.ToInt64(resultado.Response) == 2;
        }
    }
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Confirmar Recepción de Activo - Service Desk DESI</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
</head>
<body style="background-color: #f0f2f5;">
    <div class="container d-flex align-items-center justify-content-center min-vh-100">
        <div class="col-md-6 col-lg-5">
            <div class="card shadow-lg border-0 rounded-4">
                <div class="card-body text-center p-5">
                    @if (esExito && !yaConfirmado)
                    {
                        <div class="mb-4">
                            <i class="fas fa-check-circle text-success" style="font-size: 5rem;"></i>
                        </div>
                        <h3 class="mb-3" style="color: #1cc88a;">Recepción confirmada</h3>
                        <p class="text-muted mb-4">@mensaje</p>
                        <div class="alert alert-success" role="alert">
                            <i class="fas fa-thumbs-up me-2"></i> Gracias por confirmar la recepción de tu activo.
                        </div>
                    }
                    else if (esExito && yaConfirmado)
                    {
                        <div class="mb-4">
                            <i class="fas fa-info-circle text-info" style="font-size: 5rem;"></i>
                        </div>
                        <h3 class="mb-3" style="color: #36b9cc;">Recepción ya confirmada</h3>
                        <p class="text-muted mb-4">@mensaje</p>
                        <div class="alert alert-info" role="alert">
                            <i class="fas fa-check-circle me-2"></i> No se realizó ningún cambio; esta asignación ya había sido confirmada.
                        </div>
                    }
                    else
                    {
                        <div class="mb-4">
                            <i class="fas fa-exclamation-triangle text-danger" style="font-size: 5rem;"></i>
                        </div>
                        <h3 class="mb-3" style="color: #e74a3b;">Enlace inválido</h3>
                        <p class="text-muted mb-4">@mensaje</p>
                        <div class="alert alert-danger" role="alert">
                            <i class="fas fa-shield-alt me-2"></i> El enlace de confirmación no es válido o ha sido alterado. Si crees que esto es un error, contacta al área de soporte.
                        </div>
                    }

                    <a href="@Url.Action("Autentication", "Home")" class="btn btn-secondary mt-2">
                        <i class="fas fa-arrow-left me-2"></i> Ir al inicio de sesión
                    </a>
                </div>
            </div>
        </div>
    </div>
</body>
</html>
