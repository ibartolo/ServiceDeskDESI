@{
    Layout = null;

    var detalle = ViewBag.Detalle as ServiceDeskDESIEntities.Catalogos.AsignacionActivoDetalleDTO;
    var accion = ViewBag.Accion as string;
    var token = ViewBag.Token as string;
    var errorMessage = ViewBag.ErrorMessage as string;

    bool esDesvinculacion = string.Equals(accion, "desvincular", StringComparison.OrdinalIgnoreCase);
    bool yaAceptado = detalle != null && detalle.FechaConfirmacion != null;
    bool yaDesvinculado = detalle != null && detalle.FechaFin != null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Asignación de Activo - Service Desk DESI</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/Scripts/Comun/Comun.js"></script>
</head>
<body style="background-color: #f0f2f5;">
    <div class="container d-flex align-items-center justify-content-center min-vh-100">
        <div class="col-md-7 col-lg-6">
            <div class="card shadow-lg border-0 rounded-4">
                <div class="card-body p-5">

                    @if (errorMessage != null)
                    {
                        <div class="text-center">
                            <i class="fas fa-exclamation-triangle text-danger mb-3" style="font-size: 4rem;"></i>
                            <h3 class="mb-3" style="color: #e74a3b;">Enlace inválido</h3>
                            <p class="text-muted mb-4">@errorMessage</p>
                            <a href="@Url.Action("Autentication", "Home")" class="btn btn-secondary">
                                <i class="fas fa-arrow-left me-2"></i> Ir al inicio de sesión
                            </a>
                        </div>
                    }
                    else if (yaAceptado || yaDesvinculado)
                    {
                        <div class="text-center">
                            <i class="fas fa-info-circle text-info mb-3" style="font-size: 4rem;"></i>
                            <h3 class="mb-3" style="color: #36b9cc;">Este activo ya fue asignado</h3>
                            <p class="text-muted mb-4">
                                @(yaDesvinculado ? "La asignación de este activo ya fue desvinculada." : "Este activo ya fue asignado y no requiere acción adicional.")
                            </p>
                            <a href="@Url.Action("Autentication", "Home")" class="btn btn-secondary">
                                <i class="fas fa-arrow-left me-2"></i> Ir al inicio de sesión
                            </a>
                        </div>
                    }
                    else
                    {
                        <div class="text-center mb-4">
                            <i class="fas fa-laptop text-primary" style="font-size: 4rem;"></i>
                            <h3 class="mt-3 mb-1">@(esDesvinculacion ? "Desvinculación de activo" : "Asignación de activo")</h3>
                            <p class="text-muted mb-0">Revisa la información antes de continuar.</p>
                        </div>

                        <div class="border rounded p-4 mb-4 bg-light">
                            <div class="d-flex justify-content-between py-2 border-bottom">
                                <span class="text-muted"><i class="fas fa-user-check me-2"></i>Asignado por</span>
                                <strong>@(detalle?.AsignadorNombre ?? "---")</strong>
                            </div>
                            <div class="d-flex justify-content-between py-2 border-bottom">
                                <span class="text-muted"><i class="fas fa-user me-2"></i>Asignado a</span>
                                <strong>@(detalle?.PersonaNombre ?? "") @(detalle?.PersonaApellido ?? "")</strong>
                            </div>
                            <div class="d-flex justify-content-between py-2 border-bottom">
                                <span class="text-muted"><i class="fas fa-tag me-2"></i>Activo</span>
                                <strong>@(detalle?.ActivoNombre ?? "---")</strong>
                            </div>
                            <div class="d-flex justify-content-between py-2 border-bottom">
                                <span class="text-muted"><i class="fas fa-barcode me-2"></i>Serial</span>
                                <strong>@(detalle?.ActivoSerial ?? "---")</strong>
                            </div>
                            <div class="d-flex justify-content-between py-2 border-bottom">
                                <span class="text-muted"><i class="fas fa-layer-group me-2"></i>Tipo</span>
                                <strong>@(detalle?.TipoActivoNombre ?? "---")</strong>
                            </div>
                            <div class="d-flex justify-content-between py-2 border-bottom">
                                <span class="text-muted"><i class="fas fa-industry me-2"></i>Marca</span>
                                <strong>@(detalle?.MarcaNombre ?? "---")</strong>
                            </div>
                            <div class="d-flex justify-content-between py-2">
                                <span class="text-muted"><i class="fas fa-cubes me-2"></i>Modelo</span>
                                <strong>@(detalle?.ModeloNombre ?? "---")</strong>
                            </div>
                        </div>

                        <div class="d-grid">
                            @if (esDesvinculacion)
                            {
                                <button type="button" class="btn btn-danger btn-lg" onclick="abrirModalLogin()">
                                    <i class="fas fa-unlink me-2"></i> Desvincular
                                </button>
                            }
                            else
                            {
                                <button type="button" class="btn btn-success btn-lg" onclick="abrirModalLogin()">
                                    <i class="fas fa-check-circle me-2"></i> Acepto la asignación
                                </button>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    @if (errorMessage == null && !yaAceptado && !yaDesvinculado)
    {
        <div class="modal fade" id="modalLoginAsignacion" tabindex="-1" aria-labelledby="modalLoginAsignacionLabel" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="modalLoginAsignacionLabel"><i class="fas fa-sign-in-alt me-2"></i>Iniciar sesión</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                    </div>
                    <div class="modal-body">
                        <div class="alert alert-danger d-none" id="loginError">
                            <i class="fas fa-exclamation-triangle me-2"></i> Usuario o contraseña incorrectos.
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Usuario</label>
                            <input type="text" id="loginUser" class="form-control" placeholder="Nombre de usuario" autocomplete="username" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Contraseña</label>
                            <input type="password" id="loginPass" class="form-control" placeholder="Contraseña" autocomplete="current-password" />
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                        <button type="button" class="btn btn-primary" onclick="iniciarSesion()">
                            <i class="fas fa-sign-in-alt me-2"></i> Iniciar sesión
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <script>
            var tokenAsignacion = @Html.Raw(JsonConvert.SerializeObject(token));
            var esDesvinculacion = @(esDesvinculacion ? "true" : "false");

            function abrirModalLogin() {
                $("#loginError").addClass("d-none");
                $("#loginUser").val("");
                $("#loginPass").val("");
                bootstrap.Modal.getOrCreateInstance(document.getElementById('modalLoginAsignacion')).show();
            }

            function iniciarSesion() {
                var user = $("#loginUser").val();
                var pass = $("#loginPass").val();

                if (!user || !pass) {
                    $("#loginError").removeClass("d-none");
                    return;
                }

                PostMVC('/Home/LogIn', { user: user, pass: pass }, function (resp) {
                    var res = typeof resp === 'string' ? JSON.parse(resp) : resp;
                    if (res && res.IsSuccess) {
                        // Sesión creada (FormsAuth + TokenCookie). Ahora ejecutar la acción.
                        if (esDesvinculacion) {
                            PostMVC('/Home/DesvincularAsignacion', { token: tokenAsignacion }, function (r2) {
                                var acc = typeof r2 === 'string' ? JSON.parse(r2) : r2;
                                if (acc && acc.IsSuccess) {
                                    Swal.fire({
                                        title: '¡Desvinculado!',
                                        text: acc.Message,
                                        icon: 'success',
                                        timer: 2000,
                                        showConfirmButton: false,
                                        background: 'white',
                                        iconColor: '#4e73df'
                                    }).then(function () {
                                        window.location.href = '/Home/Autentication';
                                    });
                                } else {
                                    Swal.fire({
                                        title: 'Error',
                                        text: (acc && acc.Message) || 'No se pudo desvincular el activo.',
                                        icon: 'error',
                                        confirmButtonText: 'Aceptar',
                                        background: 'white',
                                        confirmButtonColor: '#4e73df'
                                    });
                                }
                            });
                        } else {
                            PostMVC('/Home/AceptarAsignacion', { token: tokenAsignacion }, function (r2) {
                                var acc = typeof r2 === 'string' ? JSON.parse(r2) : r2;
                                if (acc && acc.IsSuccess) {
                                    Swal.fire({
                                        title: '¡Aceptado!',
                                        text: acc.Message,
                                        icon: 'success',
                                        timer: 2000,
                                        showConfirmButton: false,
                                        background: 'white',
                                        iconColor: '#4e73df'
                                    }).then(function () {
                                        window.location.href = '/Home/MisActivos';
                                    });
                                } else {
                                    Swal.fire({
                                        title: 'Error',
                                        text: (acc && acc.Message) || 'No se pudo confirmar la asignación.',
                                        icon: 'error',
                                        confirmButtonText: 'Aceptar',
                                        background: 'white',
                                        confirmButtonColor: '#4e73df'
                                    });
                                }
                            });
                        }
                    } else {
                        // Credenciales incorrectas: error sin cambio de estado (Status 1 intacto)
                        $("#loginError").removeClass("d-none");
                    }
                });
            }
        </script>
    }
</body>
</html>
