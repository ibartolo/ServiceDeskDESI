@{
    ViewBag.Title = "Ayuda";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    /* ===== Estilos del manual de ayuda (autocontenido) ===== */
    .ayuda-wrap { max-width: 1140px; margin: 0 auto; padding: 8px 0 40px 0; }
    .ayuda-hero {
        background: linear-gradient(135deg, #4e73df 0%, #224abe 100%);
        color: #fff; border-radius: 14px; padding: 26px 28px; margin-bottom: 18px;
    }
    .ayuda-hero h2 { margin: 0 0 6px 0; font-weight: 700; }
    .ayuda-hero p { margin: 0; opacity: .92; }
    .ayuda-buscador {
        background: #fff; border-radius: 12px; padding: 16px 18px;
        box-shadow: 0 2px 8px rgba(0,0,0,.08); margin-bottom: 18px;
    }
    .ayuda-buscador input {
        width: 100%; border: 1px solid #d1d3e2; border-radius: 8px;
        padding: 10px 14px; font-size: 1rem;
    }
    .ayuda-resultado-msg { margin-top: 8px; font-size: .85rem; color: #6c757d; min-height: 20px; }
    .ayuda-indice {
        background: #fff; border-radius: 12px; padding: 14px 18px; margin-bottom: 18px;
        box-shadow: 0 2px 8px rgba(0,0,0,.06);
    }
    .ayuda-indice a { text-decoration: none; }
    .chip {
        display: inline-block; background: #eaedf7; color: #2e59d9; border-radius: 20px;
        padding: 5px 12px; margin: 3px 4px 3px 0; font-size: .82rem; cursor: pointer;
    }
    .chip:hover { background: #d7def2; }
    .seccion-card {
        background: #fff; border: 1px solid #e3e6f0; border-radius: 12px;
        padding: 20px 22px; margin-bottom: 16px; box-shadow: 0 1px 4px rgba(0,0,0,.04);
    }
    .seccion-card h3 {
        color: #224abe; font-size: 1.25rem; font-weight: 700;
        border-bottom: 2px solid #eaedf7; padding-bottom: 8px; margin-bottom: 12px;
    }
    .seccion-card h4 { color: #333; font-size: 1.02rem; font-weight: 700; margin: 14px 0 6px 0; }
    .seccion-card .subtitulo { color: #4e73df; font-weight: 600; margin: 10px 0 4px 0; }
    .seccion-card ul, .seccion-card ol { margin-bottom: 8px; }
    .seccion-card li { margin-bottom: 3px; }
    .enlace-app {
        display: inline-block; background: #4e73df; color: #fff !important; text-decoration: none !important;
        border-radius: 6px; padding: 4px 10px; font-size: .85rem; margin: 2px 4px 2px 0;
    }
    .enlace-app:hover { background: #224abe; }
    .enlace-seccion { color: #2e59d9; text-decoration: underline; }
    .aviso {
        background: #fff8e6; border-left: 4px solid #f6c23e; padding: 8px 12px;
        border-radius: 6px; font-size: .9rem; margin: 8px 0;
    }
    .tip {
        background: #eafaf1; border-left: 4px solid #1cc88a; padding: 8px 12px;
        border-radius: 6px; font-size: .9rem; margin: 8px 0;
    }
    .danger-tip {
        background: #fdecec; border-left: 4px solid #e74a3b; padding: 8px 12px;
        border-radius: 6px; font-size: .9rem; margin: 8px 0;
    }
    /* Diagrama de flujo simple */
    .flujo { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; margin: 10px 0 6px 0; }
    .flujo .f-paso {
        background: #eaedf7; color: #1e2a4a; border: 1px solid #c9d4f5; border-radius: 8px;
        padding: 8px 12px; font-size: .85rem; font-weight: 600; text-align: center; min-width: 90px;
    }
    .flujo .f-paso.estado { background: #4e73df; color: #fff; border-color: #4e73df; }
    .flujo .f-paso.accion { background: #1cc88a; color: #fff; border-color: #1cc88a; }
    .flujo .f-paso.decision { background: #f6c23e; color: #1e2a4a; border-color: #f6c23e; }
    .flujo .f-flecha { font-weight: 700; color: #858796; }
    .flujo .f-flecha.doble { color: #e74a3b; }
    .tabla-campos { width: 100%; border-collapse: collapse; margin: 8px 0; font-size: .9rem; }
    .tabla-campos th, .tabla-campos td { border: 1px solid #e3e6f0; padding: 6px 10px; text-align: left; }
    .tabla-campos th { background: #f8f9fc; }
    .faq-q { font-weight: 700; margin: 12px 0 4px 0; color: #1e2a4a; }
    .faq-q::before { content: "Q: "; color: #4e73df; }
    .faq-a { margin: 0 0 10px 0; }
    .faq-a::before { content: "R: "; color: #1cc88a; font-weight: 700; }
    .volver-arriba {
        position: fixed; right: 18px; bottom: 18px; z-index: 900;
        background: #4e73df; color: #fff; border-radius: 50%; width: 44px; height: 44px;
        display: flex; align-items: center; justify-content: center; font-size: 1.1rem;
        box-shadow: 0 2px 8px rgba(0,0,0,.3); cursor: pointer; text-decoration: none;
    }
    .volver-arriba:hover { background: #224abe; color: #fff; }
    body.dark-theme .ayuda-buscador,
    body.dark-theme .ayuda-indice,
    body.dark-theme .seccion-card { background: #252b43; border-color: #3a4163; color: #e4e6ef; }
    body.dark-theme .seccion-card h3 { color: #9db4f0; border-color: #3a4163; }
    body.dark-theme .seccion-card h4, body.dark-theme .faq-q { color: #e4e6ef; }
    body.dark-theme .tabla-campos th { background: #303754; color: #e4e6ef; }
    body.dark-theme .tabla-campos td, body.dark-theme .tabla-campos th { border-color: #3a4163; }
    body.dark-theme .chip { background: #303754; color: #9db4f0; }
    body.dark-theme .flujo .f-paso { background: #303754; color: #e4e6ef; border-color: #4a5278; }
    body.dark-theme .aviso { background: #40371a; border-left-color: #f6c23e; }
    body.dark-theme .tip { background: #16342a; border-left-color: #1cc88a; }
    body.dark-theme .danger-tip { background: #3d2020; border-left-color: #e74a3b; }
    body.dark-theme .ayuda-buscador input { background: #1d2233; color: #e4e6ef; border-color: #3a4163; }
</style>

<div class="ayuda-wrap">
    <div class="ayuda-hero">
        <h2><i class="fas fa-question-circle me-2"></i>Centro de Ayuda</h2>
        <p>Guía rápida y sencilla para usar Service Desk DESI. Escribe una palabra clave para encontrar el tema que buscas, o navega por las secciones.</p>
    </div>

    <div class="ayuda-buscador">
        <input type="text" id="buscadorAyuda" placeholder="Buscar: ticket, pausar, materiales, terceros, activo, tipo de activo, asignar, correo, contraseña, permiso, marca, modelo, horario, estadísticas, empresa, logo..." autocomplete="off">
        <div class="ayuda-resultado-msg" id="resultadoMsg"></div>
    </div>

    <div class="ayuda-indice">
        <strong>Índice rápido:</strong><br>
        <a class="chip" data-ir="#que-es">¿Qué es?</a>
        <a class="chip" data-ir="#primer-acceso">Primer acceso</a>
        <a class="chip" data-ir="#tickets">Tickets</a>
        <a class="chip" data-ir="#activos">Activos</a>
        <a class="chip" data-ir="#tipo-activo">Tipo de activo</a>
        <a class="chip" data-ir="#marca">Marca</a>
        <a class="chip" data-ir="#modelo">Modelo</a>
        <a class="chip" data-ir="#catalogos">Catálogos</a>
        <a class="chip" data-ir="#personal-usuarios">Personal y usuarios</a>
        <a class="chip" data-ir="#roles-permisos">Roles y permisos</a>
        <a class="chip" data-ir="#empresa-licencia">Empresa y licencia</a>
        <a class="chip" data-ir="#correos">Correos que recibes</a>
        <a class="chip" data-ir="#configuracion">Perfil y configuración</a>
        <a class="chip" data-ir="#configuracion-empresa">Configuración de empresa</a>
        <a class="chip" data-ir="#estadisticas">Estadísticas</a>
        <a class="chip" data-ir="#preguntas">Preguntas frecuentes</a>
        <a class="chip" data-ir="#glosario">Glosario</a>
    </div>

    <!-- ============================================================ -->
    <section class="seccion-card" id="que-es" data-tags="que es sistema ayuda service desk tickets activos">
        <h3><i class="fas fa-info-circle me-2"></i>¿Qué es Service Desk DESI?</h3>
        <p>Es la <strong>mesa de ayuda</strong> de tu empresa: un solo lugar para:</p>
        <ul>
            <li><strong>Reportar y dar seguimiento</strong> a solicitudes o problemas (tickets).</li>
            <li><strong>Registrar y asignar activos</strong> (equipos de cómputo, licencias, mobiliario, etc.) a las personas.</li>
            <li><strong>Mantener catálogos</strong> ordenados (tipos de activo, marcas, modelos, áreas, categorías...).</li>
            <li><strong>Controlar accesos</strong>: cada persona entra con su usuario y ve solo lo que su rol le permite.</li>
        </ul>
        <p>Todo lo que haces queda <strong>registrado con fecha y responsable</strong>, así siempre hay trazabilidad.</p>
    </section>

    <!-- ============================================================ -->
    <section class="seccion-card" id="primer-acceso" data-tags="primera vez entrar login usuario contrasena credenciales bienvenida password">
        <h3><i class="fas fa-door-open me-2"></i>Primer acceso (cuando te dan de alta)</h3>
        <div class="flujo">
            <div class="f-paso accion">1. Te llega un correo de bienvenida</div>
            <div class="f-flecha">&#10132;</div>
            <div class="f-paso accion">2. Revisa tu usuario y contraseña temporal</div>
            <div class="f-flecha">&#10132;</div>
            <div class="f-paso accion">3. Entra en la página de login</div>
            <div class="f-flecha">&#10132;</div>
            <div class="f-paso estado">4. ¡Listo, ya estás dentro!</div>
        </div>
        <h4>Qué hacer:</h4>
        <ol>
            <li>Busca en tu correo el mensaje de <strong>bienvenida</strong> (revisa también la carpeta de spam).</li>
            <li>El correo trae tu <strong>usuario</strong> (normalmente tu nombre + apellido, sin espacios) y una <strong>contraseña temporal</strong>.</li>
            <li>Entra en <a href="/Home/Autentication">la pantalla de acceso</a> y escribe esos datos.</li>
        </ol>
        <div class="tip"><strong>Consejo:</strong> si no recibes el correo o ya caducó la contraseña temporal, usa la opción "¿Olvidaste tu contraseña?" de la pantalla de acceso o pídele a tu administrador que te apoye.</div>
        <div class="danger-tip"><strong>Importante:</strong> tu usuario es personal e intransferible. No lo compartas.</div>
    </section>

    <!-- ============================================================ -->
    <section class="seccion-card" id="tickets" data-tags="ticket solicitud reportar problema soporte folio capturar nuevo atender resolver cerrar rechazar estatus ciclo pausar pausado reanudar reanudado materiales refacciones insumo terceros proveedor externo espera compra mantenimiento">
        <h3><i class="fas fa-ticket-alt me-2"></i>Tickets (solicitudes de soporte)</h3>
        <p>Un <strong>ticket</strong> es una solicitud de ayuda: "no me abre el sistema", "necesito una licencia", "mi equipo no enciende"... Todo empieza capturando un ticket.</p>

        <h4>¿Cómo capturar un ticket nuevo?</h4>
        <div class="flujo">
            <div class="f-paso accion">1. Menú Tickets</div>
            <div class="f-flecha">&#10132;</div>
            <div class="f-paso accion">2. Botón "Nuevo Ticket"</div>
            <div class="f-flecha">&#10132;</div>
            <div class="f-paso accion">3. Elige Área → Categoría → Subcategoría</div>
            <div class="f-flecha">&#10132;</div>
            <div class="f-paso accion">4. Indica urgencia, título y descripción</div>
            <div class="f-flecha">&#10132;</div>
            <div class="f-paso estado">5. Guardar: se genera tu folio</div>
        </div>
        <p>Entra en <a class="enlace-app" href="/Ticket/Index">Ir a Tickets</a></p>
        <ul>
            <li>Selecciona el <strong>área</strong> a la que pertenece tu duda (las listas se van filtrando solas).</li>
            <li>La <strong>urgencia</strong> va del 1 (baja) al 4 (crítica).</li>
            <li>Escribe un <strong>título corto</strong> y una <strong>descripción</strong> con el detalle del problema.</li>
            <li>Al guardar, el sistema asigna un <strong>folio único</strong> (ej. T-00001). Con ese folio identificas tu ticket.</li>
        </ul>
        <div class="aviso"><strong>Atención:</strong> una vez creado, el ticket <u>no se puede editar</u>; queda registrado tal cual para mantener un historial confiable.</div>

        <h4>Ciclo de vida de un ticket</h4>
        <div class="flujo">
            <div class="f-paso estado">Nuevo</div>
            <div class="f-flecha">&#10132;</div>
            <div class="f-paso estado">En Progreso</div>
            <div class="f-flecha">&#10132;</div>
            <div class="f-paso estado">Resuelto</div>
            <div class="f-flecha">&#10132;</div>
            <div class="f-paso estado">Cerrado</div>
        </div>
        <div class="flujo">
            <div class="f-paso decision">Resuelto pero no conforme</div>
            <div class="f-flecha doble">&#10132;</div>
            <div class="f-paso estado">Rechazado → lo retoma el agente</div>
        </div>
        <ul>
            <li><strong>Nuevo:</strong> acabas de crearlo y espera atención.</li>
            <li><strong>En Progreso:</strong> un agente lo tomó y está trabajando en él.</li>
            <li><strong>Pendiente de Materiales:</strong> el agente no puede continuar porque falta una compra, refacción o un mantenimiento de un tercero que aún no se ejecuta (por ejemplo, una memoria RAM que tarda en llegar). El ticket <u>sigue abierto</u>; no está resuelto ni rechazado.</li>
            <li><strong>En Espera de Terceros:</strong> el avance depende de un proveedor externo (por ejemplo, el soporte del hosting) y el tiempo de espera <u>no depende de tu empresa</u>. El ticket <u>sigue abierto</u>.</li>
            <li><strong>Resuelto:</strong> el agente indica qué hizo, con un comentario.</li>
            <li><strong>Cerrado:</strong> tú (solicitante) confirmas que quedó resuelto.</li>
            <li><strong>Rechazado:</strong> si no quedó resuelto, lo devuelves explicando por qué; el agente puede retomarlo.</li>
        </ul>

        <h4>Pausar y reanudar un ticket (espera por materiales o terceros)</h4>
        <p>Cuando el avance de un ticket <strong>no depende del agente</strong> (falta un insumo, o se espera a un proveedor externo), el agente <strong>pausa</strong> el ticket en lugar de dejarlo "En Progreso".</p>
        <div class="flujo">
            <div class="f-paso estado">En Progreso</div>
            <div class="f-flecha">&#10132;</div>
            <div class="f-paso accion">Pausar (motivo + detalle)</div>
            <div class="f-flecha">&#10132;</div>
            <div class="f-paso estado">Pendiente de Materiales / En Espera de Terceros</div>
            <div class="f-flecha">&#10132;</div>
            <div class="f-paso accion">Reanudar</div>
            <div class="f-flecha">&#10132;</div>
            <div class="f-paso estado">En Progreso</div>
        </div>
        <ul>
            <li>Al pausar, el agente elige el <strong>motivo</strong>:
                <ul>
                    <li><strong>Pendiente de Materiales:</strong> falta un insumo o refacción (compra/almacén) o un mantenimiento de un tercero.</li>
                    <li><strong>En Espera de Terceros:</strong> se espera la respuesta de un proveedor externo (el tiempo no lo controla la empresa).</li>
                </ul>
            </li>
            <li>El <strong>detalle</strong> es obligatorio (qué se espera) y, si se conoce, se puede indicar una <strong>fecha estimada</strong> de respuesta.</li>
            <li>Cuando llega el material o responde el tercero, el agente ejecuta <strong>Reanudar</strong> y el ticket vuelve a <strong>En Progreso</strong>.</li>
            <li>Mientras está pausado, el ticket <strong>sigue abierto</strong>, aparece en el listado con su fecha estimada y <strong>no</strong> cuenta como resuelto ni cerrado.</li>
            <li>Un ticket pausado <strong>no</strong> se puede resolver, rechazar, cerrar ni reasignar hasta que se reanude.</li>
        </ul>
        <div class="tip"><strong>Tip:</strong> usa "Pendiente de Materiales" cuando dependas de algo que tu empresa debe comprar o preparar, y "En Espera de Terceros" cuando el tiempo lo controle un proveedor externo. Así queda claro por qué el ticket no avanza.</div>

        <h4>¿Qué puedes hacer según tu rol?</h4>
        <table class="tabla-campos">
            <thead><tr><th>Rol</th><th>Puede hacer</th></tr></thead>
            <tbody>
                <tr><td><strong>Solicitante</strong></td><td>Crear tickets, ver los propios, cerrar o rechazar sus tickets resueltos.</td></tr>
                <tr><td><strong>Agente</strong></td><td>Ver tickets de su área, tomarlos, resolverlos, retomarlos y <strong>pausarlos / reanudarlos</strong> (Pendiente de Materiales / En Espera de Terceros).</td></tr>
                <tr><td><strong>Responsable de área</strong></td><td>Ver tickets de su área y reasignarlos a otro agente.</td></tr>
            </tbody>
        </table>
        <div class="tip"><strong>Tip:</strong> el historial del ticket (quién, cuándo y qué hizo) lo ves en el detalle, en modo solo lectura.</div>
    </section>

    <!-- ============================================================ -->
    <section class="seccion-card" id="activos" data-tags="activo equipo computadora licencia asignar inventario capturar nuevo activo alta serial">
        <h3><i class="fas fa-laptop me-2"></i>Activos (inventario de equipos y bienes)</h3>
        <p>Un <strong>activo</strong> es cualquier bien que tu empresa controla: una laptop, un monitor, una licencia de software, un celular, etc. Se registran en el módulo de <strong>Activos</strong> y después pueden <strong>asignarse a una persona</strong>.</p>

        <h4>¿Cómo capturar un activo nuevo?</h4>
        <div class="flujo">
            <div class="f-paso accion">1. Menú Activos</div>
            <div class="f-flecha">&#10132;</div>
            <div class="f-paso accion">2. Botón nuevo / alta</div>
            <div class="f-flecha">&#10132;</div>
            <div class="f-paso accion">3. Llena los datos del activo</div>
            <div class="f-flecha">&#10132;</div>
            <div class="f-paso estado">4. Guardar</div>
        </div>
        <p>Entra en <a class="enlace-app" href="/Catalogs/Active">Ir a Activos</a></p>
        <p class="subtitulo">Campos principales y su significado:</p>
        <table class="tabla-campos">
            <thead><tr><th>Campo</th><th>Qué es</th></tr></thead>
            <tbody>
                <tr><td>Nombre</td><td>Nombre con el que identificas el activo (ej. "Laptop HP Mary").</td></tr>
                <tr><td><a class="enlace-seccion" href="/Catalogs/TypeActive">Tipo de activo</a></td><td>Clasificación del bien: computadora, monitor, impresora, licencia... <a class="enlace-seccion" href="#tipo-activo">Ver explicación</a>.</td></tr>
                <tr><td>Serial / Serie</td><td>Número de serie que trae el equipo (si aplica).</td></tr>
                <tr><td><a class="enlace-seccion" href="/Catalogs/Mark">Marca</a></td><td>Fabricante: HP, Dell, Lenovo, Samsung... <a class="enlace-seccion" href="#marca">Ver explicación</a>.</td></tr>
                <tr><td><a class="enlace-seccion" href="/Catalogs/Model">Modelo</a></td><td>Referencia exacta del equipo (depende de la marca). <a class="enlace-seccion" href="#modelo">Ver explicación</a>.</td></tr>
                <tr><td>Fecha de compra</td><td>Cuándo se adquirió (opcional, ayuda al control).</td></tr>
                <tr><td>Notas</td><td>Observaciones: estado físico, garantía, ubicación, etc.</td></tr>
            </tbody>
        </table>
        <div class="aviso"><strong>Permisos:</strong> para capturar, editar o eliminar activos tu rol necesita el permiso correspondiente (lo configura el administrador en <a class="enlace-seccion" href="/Security/Permisos">Permisos</a>). Si no ves el botón, pídelo a tu administrador.</div>

        <h4>Asignar un activo a una persona</h4>
        <div class="flujo">
            <div class="f-paso accion">Administrador asigna el activo</div>
            <div class="f-flecha">&#10132;</div>
            <div class="f-paso accion">Llega correo a la persona</div>
            <div class="f-flecha">&#10132;</div>
            <div class="f-paso accion">La persona se identifica y confirma</div>
            <div class="f-flecha">&#10132;</div>
            <div class="f-paso estado">Aparece en "Mis Activos"</div>
        </div>
        <ul>
            <li>Solo quien recibe el activo puede <strong>confirmar la recepción</strong> con sus propias credenciales; nadie puede aceptar por él.</li>
            <li>La liga del correo no caduca: la persona puede confirmar cuando quiera.</li>
            <li>Cada usuario ve sus activos en <a class="enlace-app" href="/Home/MisActivos">Mis Activos</a> (vigentes y pendientes de aceptar).</li>
            <li>Para devolver un activo, el administrador inicia la <strong>desvinculación</strong> y la persona confirma por correo.</li>
        </ul>
    </section>

    <!-- ============================================================ -->
    <section class="seccion-card" id="tipo-activo" data-tags="tipo activo clasificacion computadora monitor impresora licencia catalogo">
        <h3><i class="fas fa-tag me-2"></i>Tipo de activo</h3>
        <p>Es el <strong>catálogo de clasificación</strong> que usan los activos: computadora, monitor, impresora, celular, licencia, mobiliario, etc. Tenerlo ordenado te permite filtrar el inventario fácilmente.</p>
        <ul>
            <li><strong>Dónde está:</strong> menú lateral → Activos → Tipo de activo, o directamente <a class="enlace-app" href="/Catalogs/TypeActive">Tipo de activo</a>.</li>
            <li><strong>Qué datos necesita:</strong> nombre (ej. "Computadora") y, si quieres, una descripción corta.</li>
            <li><strong>Para qué sirve:</strong> al capturar un activo eliges su tipo de una lista; así todos los equipos iguales quedan agrupados.</li>
        </ul>
        <div class="tip"><strong>Tip:</strong> si un tipo no existe, primero créalo aquí y después úsalo en el alta del activo.</div>
    </section>

    <!-- ============================================================ -->
    <section class="seccion-card" id="marca" data-tags="marca fabricante hp dell lenovo samsung catalogo">
        <h3><i class="fas fa-copyright me-2"></i>Marca</h3>
        <p>Es el <strong>fabricante</strong> del equipo o bien: HP, Dell, Lenovo, Samsung, Epson, etc.</p>
        <ul>
            <li><strong>Dónde está:</strong> menú lateral → Activos → Marca, o directamente <a class="enlace-app" href="/Catalogs/Mark">Marca</a>.</li>
            <li><strong>Qué datos necesita:</strong> nombre de la marca y, si quieres, una descripción.</li>
            <li><strong>Relación:</strong> los <a class="enlace-seccion" href="#modelo">modelos</a> pertenecen a una marca.</li>
        </ul>
    </section>

