@model ServiceDeskDESIEntities.Catalogos.Empresa
@{
    ViewBag.Title = "Configuración de Empresa";
    Layout = "~/Views/Shared/_Layout.cshtml";
    bool puedeEditar = (ViewBag.PuedeEditar != null && (bool)ViewBag.PuedeEditar);
}

@helper HoraSelect(string tipo)
{
    <div class="hora-group hora-@tipo d-flex gap-1">
        <select class="form-select form-select-sm sel-hora" style="width:72px;">
            @for (int h = 1; h <= 12; h++)
            {
                <option value="@h">@h</option>
            }
        </select>
        <select class="form-select form-select-sm sel-minuto" style="width:82px;">
            @for (int m = 0; m < 60; m += 5)
            {
                <option value="@(m.ToString("00"))">@(m.ToString("00"))</option>
            }
        </select>
        <select class="form-select form-select-sm sel-ampm" style="width:82px;">
            <option value="AM">AM</option>
            <option value="PM">PM</option>
        </select>
    </div>
}

<div class="form-section">
    <h3 class="section-title"><i class="fas fa-cog me-2"></i>Configuración de Empresa</h3>

    <!-- ========================================= -->
    <!-- 1. CARD DATOS GENERALES (SOLO LECTURA)   -->
    <!-- ========================================= -->
    <div class="card mb-4">
        <div class="card-header">
            <i class="fas fa-building me-2"></i>Datos generales
        </div>
        <div class="card-body">
            @if (Model == null)
            {
                <div class="alert alert-warning">No se pudo obtener la información de la empresa.</div>
            }
            else
            {
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="fw-bold">Nombre comercial</label>
                        <div>@Model.NombreComercial</div>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="fw-bold">Razón social</label>
                        <div>@Model.RazonSocial</div>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="fw-bold">RFC</label>
                        <div>@Model.RFC</div>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="fw-bold">Responsable</label>
                        <div>@Model.Responsable</div>
                    </div>
                    <div class="col-md-12 mb-3">
                        <label class="fw-bold">Dirección</label>
                        <div>@Model.Direccion</div>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="fw-bold">Ciudad</label>
                        <div>@Model.Ciudad</div>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="fw-bold">Estado</label>
                        <div>@Model.Estado</div>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="fw-bold">Código postal</label>
                        <div>@Model.CodigoPostal</div>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="fw-bold">Teléfono</label>
                        <div>@Model.Telefono</div>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="fw-bold">Correo de contacto</label>
                        <div>@Model.CorreoContacto</div>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="fw-bold">Inicio de vigencia</label>
                        <div>@Model.FechaVigenciaInicio.ToString("yyyy-MM-dd")</div>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="fw-bold">Fin de vigencia</label>
                        <div>@Model.FechaVigenciaFin.ToString("yyyy-MM-dd")</div>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="fw-bold">Periodo de prueba</label>
                        <div>@(Model.EsPeriodoPrueba ? "Sí" : "No")</div>
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- ========================================= -->
    <!-- 2. EDITOR DE HORARIO LABORAL (7 DÍAS)    -->
    <!-- ========================================= -->
    <div class="card mb-4">
        <div class="card-header">
            <i class="fas fa-clock me-2"></i>Horario laboral
        </div>
        <div class="card-body">
            <table class="table table-bordered align-middle" id="tablaHorario">
                <thead>
                    <tr>
                        <th style="width:150px;">Día</th>
                        <th style="width:110px; text-align:center;">¿Labora?</th>
                        <th>Hora de inicio</th>
                        <th>Hora de fin</th>
                    </tr>
                </thead>
                <tbody>
                    <tr data-dia="1"><td>Lunes</td><td class="text-center"><input type="checkbox" class="chkLabora form-check-input" /></td><td>@HoraSelect("inicio")</td><td>@HoraSelect("fin")</td></tr>
                    <tr data-dia="2"><td>Martes</td><td class="text-center"><input type="checkbox" class="chkLabora form-check-input" /></td><td>@HoraSelect("inicio")</td><td>@HoraSelect("fin")</td></tr>
                    <tr data-dia="3"><td>Miércoles</td><td class="text-center"><input type="checkbox" class="chkLabora form-check-input" /></td><td>@HoraSelect("inicio")</td><td>@HoraSelect("fin")</td></tr>
                    <tr data-dia="4"><td>Jueves</td><td class="text-center"><input type="checkbox" class="chkLabora form-check-input" /></td><td>@HoraSelect("inicio")</td><td>@HoraSelect("fin")</td></tr>
                    <tr data-dia="5"><td>Viernes</td><td class="text-center"><input type="checkbox" class="chkLabora form-check-input" /></td><td>@HoraSelect("inicio")</td><td>@HoraSelect("fin")</td></tr>
                    <tr data-dia="6"><td>Sábado</td><td class="text-center"><input type="checkbox" class="chkLabora form-check-input" /></td><td>@HoraSelect("inicio")</td><td>@HoraSelect("fin")</td></tr>
                    <tr data-dia="7"><td>Domingo</td><td class="text-center"><input type="checkbox" class="chkLabora form-check-input" /></td><td>@HoraSelect("inicio")</td><td>@HoraSelect("fin")</td></tr>
                </tbody>
            </table>

            @if (puedeEditar)
            {
                <button type="button" id="btnGuardarHorario" class="btn btn-success">
                    <span class="spinner-border spinner-border-sm d-none" id="spinnerHorario" role="status" aria-hidden="true"></span>
                    <span id="txtGuardarHorario">Guardar</span>
                </button>
            }
        </div>
    </div>

    <!-- ========================================= -->
    <!-- 3. SUBIDA DE LOGOTIPO (SVG / PNG)        -->
    <!-- ========================================= -->
    <div class="card mb-4">
        <div class="card-header">
            <i class="fas fa-image me-2"></i>Logotipo de la empresa
        </div>
        <div class="card-body">
            <div class="d-flex align-items-center gap-3 mb-3">
                @if (Model != null && !string.IsNullOrEmpty(Model.LogoUrl))
                {
                    <img id="imgLogoPreview" src="@Model.LogoUrl" alt="Logotipo actual" style="max-width:120px; max-height:60px; object-fit:contain;" />
                }
                else
                {
                    <img id="imgLogoPreview" src="" alt="Vista previa del logotipo" style="max-width:120px; max-height:60px; object-fit:contain; display:none;" />
                }
            </div>

            @if (puedeEditar)
            {
                <div class="d-flex align-items-center gap-3 mb-2">
                    <input type="file" id="fileLogo" class="form-control" accept=".svg,.png" style="max-width:320px;" />
                    <button type="button" id="btnSubirLogo" class="btn btn-primary">
                        <span class="spinner-border spinner-border-sm d-none" id="spinnerLogo" role="status" aria-hidden="true"></span>
                        <span id="txtSubirLogo">Subir</span>
                    </button>
                    <button type="button" id="btnQuitarLogo" class="btn btn-outline-danger" style="@(Model != null && !string.IsNullOrEmpty(Model.LogoUrl) ? "" : "display:none;")">
                        <span class="spinner-border spinner-border-sm d-none" id="spinnerQuitarLogo" role="status" aria-hidden="true"></span>
                        <span id="txtQuitarLogo">Quitar logo</span>
                    </button>
                </div>
                <small class="text-muted">Formatos permitidos: @ViewBag.LogoEmpresaTiposPermitidos. Tamaño máximo: @ViewBag.LogoEmpresaMaxTamanoKB KB.</small>
            }
        </div>
    </div>
</div>

<script>
    var puedeEditar = @(puedeEditar ? "true" : "false");
</script>
<script src="@Url.Content("~/Scripts/ConfiguracionEmpresa/Index.js")"></script>
