<div class="modal fade" id="modalReasignarTicket" tabindex="-1" aria-labelledby="modalReasignarTicketLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalReasignarTicketLabel"><i class="fas fa-user-plus me-2"></i>Reasignar ticket</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="ticketIdReasignar" name="ticketId" />

                <div class="mb-3">
                    <label>Usuario:</label>
                    <select id="ddlUsuarioReasignar" name="nuevoUsuarioId" class="form-control">
                        <option value="">Seleccione un usuario</option>
                    </select>
                </div>

                <div class="mb-3">
                    <label>Comentario (obligatorio, máximo 300 caracteres):</label>
                    <textarea id="comentarioReasignar" name="comentario" class="form-control" rows="3" maxlength="300" placeholder="Escriba el motivo de la reasignación"></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-primary" onclick="ConfirmarReasignar()">Reasignar</button>
            </div>
        </div>
    </div>
</div>

<script src="@Url.Content("~/Scripts/Ticket/_ReasignarTicket.js")"></script>
