@model ServiceDeskDESIEntities.Tickets.Ticket
@{
    ViewBag.Title = "Tickets";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var permisos = ViewBag.Permisos as PermisosViewModel;
}

<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.1/jquery.validate.min.js"></script>
<script src="https://cdn.datatables.net/2.3.7/js/dataTables.js"></script>
<link href="https://cdn.datatables.net/2.3.7/css/dataTables.dataTables.css" rel="stylesheet" />

<style>
    .ticket-mio {
        background-color: #e8f4ff !important;
    }
</style>

<div class="form-section">
    @if (ViewBag.ErrorMessage != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-circle"></i> @ViewBag.ErrorMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3 class="section-title mb-0"><i class="fas fa-ticket-alt me-2"></i>Tickets</h3>

        @if (permisos != null && permisos.PuedeCrear)
        {
            <button type="button" class="btn btn-success" data-bs-toggle="modal" data-bs-target="#modalCapturarTicket">
                <i class="fas fa-plus me-1"></i>Nuevo Ticket
            </button>
        }
    </div>

    <!--<div class="row">
        <div class="col-md-12">
            <div class="mb-3">
                <label>Filtrar por Área:</label>
                @Html.DropDownList("ddlFiltroArea", new SelectList(ViewBag.Areas, "Id", "Nombre"), "Todas las áreas", new { @class = "form-control w-25", id = "ddlFiltroArea" })
            </div>
        </div>
    </div>-->

    <div class="row">
        <div class="col-md-12 table-responsive">
            <div class="mb-3">
                <table id="tblTicket" class="table table-striped">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Título</th>
                            <th>Área</th>
                            <th>Categoría</th>
                            <th>Subcategoría</th>
                            <th>Urgencia</th>
                            <th>Estatus</th>
                            <th>Agente</th>
                            <th>Fecha Creación</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@Html.Partial("_CapturarTicket")
@Html.Partial("_ReasignarTicket")
@Html.Partial("_DetalleTicket")

<script>
    // Pasar permisos y datos de sesión a JavaScript
    var permisosGlobal = @Html.Raw(JsonConvert.SerializeObject(permisos));
    var esAgenteGlobal = @Html.Raw(JsonConvert.SerializeObject(ViewBag.EsAgente ?? false));
    var usuarioActualIdGlobal = @Html.Raw(JsonConvert.SerializeObject(ViewBag.UsuarioActualId ?? 0));
    var esResponsableAreaGlobal = @Html.Raw(JsonConvert.SerializeObject(ViewBag.EsResponsableArea ?? false));

    // Configuración de evidencias (límites y extensiones) para validación client-side
    var evidenciaConfig = @Html.Raw(JsonConvert.SerializeObject(ViewBag.EvidenciaConfig)) || { MaxArchivos: 3, MaxTamanoMB: 3, ExtensionesPermitidas: ["pdf", "jpg", "png"] };

    // Id del ticket actualmente abierto en el detalle (para subir evidencias desde el detalle)
    var ticketDetalleActualId = 0;

    var tablaTicket;

    $(document).ready(function () {
        // Inicializar DataTable
        InicializarDataTable();

        // Cargar tabla según el filtro actual
        var areaId = $("#ddlFiltroArea").val();
        if (areaId && areaId !== "") {
            ConsultarTicketsPorArea(areaId);
        } else {
            ConsultarTodasTickets();
        }

        // Eventos
        $("#ddlFiltroArea").change(function () {
            RefrescarTabla();
        });
    });

    function InicializarDataTable() {
        tablaTicket = $('#tblTicket').DataTable({
            columns: [
                { data: 'Id', title: 'ID', visible: false },
                { data: 'Titulo', title: 'Título' },
                { data: 'AreaNombre', title: 'Área' },
                { data: 'CategoriaNombre', title: 'Categoría' },
                { data: 'SubcategoriaNombre', title: 'Subcategoría', defaultContent: '---' },
                {
                    data: 'Urgencia',
                    title: 'Urgencia',
                    render: function (data) {
                        return badgeUrgencia(data);
                    }
                },
                {
                    data: 'EstatusNombre',
                    title: 'Estatus',
                    defaultContent: '---',
                    render: function (data, type, row) {
                        if (row.EstatusColor) {
                            return '<span class="badge" style="background-color: ' + row.EstatusColor + '; color: white;">' + row.EstatusNombre + '</span>';
                        }
                        return data || '---';
                    }
                },
                {
                    data: 'AgenteNombre',
                    title: 'Agente',
                    defaultContent: '---',
                    render: function (data, type, row) {
                        if (row.AgenteNombre) {
                            return row.AgenteNombre + ' ' + (row.AgenteApellido || '');
                        }
                        return '---';
                    }
                },
                {
                    data: 'FechaCreacion',
                    title: 'Fecha Creación',
                    render: function (data) {
                        if (data) {
                            var fecha = new Date(data);
                            return fecha.toLocaleDateString();
                        }
                        return '---';
                    }
                },
                {
                    data: 'Id', title: 'Acciones', render: function (data, type, row) {
                        var html = '<div class="d-flex gap-2">';

                        // Tomar - agente, ticket nuevo y sin agente asignado
                        if (esAgenteGlobal && row.TicketEstatusId === 1 && !row.AgenteId) {
                            html += '<button type="button" class="btn btn-sm btn-outline-success" title="Tomar ticket" onclick="TomarTicket(' + data + ')"><i class="fas fa-hand-paper"></i></button>';
                        }

                        // Ver - siempre
                        html += '<button type="button" class="btn btn-sm btn-outline-secondary" title="Ver detalle" onclick="VerTicket(' + data + ')"><i class="fas fa-eye"></i></button>';

                        // Resolver - agente dueño del ticket en progreso
                        if (esAgenteGlobal && row.AgenteId === usuarioActualIdGlobal && row.TicketEstatusId === 2) {
                            html += '<button type="button" class="btn btn-sm btn-outline-primary" title="Resolver ticket" onclick="ResolverTicket(' + data + ')"><i class="fas fa-check-circle"></i></button>';
                        }

                        // Retomar - agente sobre un ticket rechazado
                        if (esAgenteGlobal && row.TicketEstatusId === 4) {
                            html += '<button type="button" class="btn btn-sm btn-outline-warning" title="Retomar ticket" onclick="RetomarTicket(' + data + ')"><i class="fas fa-redo"></i></button>';
                        }

                        // Cerrar - solicitante dueño sobre un ticket resuelto
                        if (row.CreadoPorId === usuarioActualIdGlobal && row.TicketEstatusId === 3) {
                            html += '<button type="button" class="btn btn-sm btn-outline-success" title="Cerrar ticket" onclick="CerrarTicket(' + data + ')"><i class="fas fa-check-double"></i></button>';
                        }

                        // Rechazar - solicitante dueño sobre un ticket resuelto
                        if (row.CreadoPorId === usuarioActualIdGlobal && row.TicketEstatusId === 3) {
                            html += '<button type="button" class="btn btn-sm btn-outline-danger" title="Rechazar ticket" onclick="RechazarTicket(' + data + ')"><i class="fas fa-times-circle"></i></button>';
                        }

                        // Reasignar - responsable de área sobre un ticket en progreso o rechazado
                        if (esResponsableAreaGlobal && (row.TicketEstatusId === 2 || row.TicketEstatusId === 4)) {
                            html += '<button type="button" class="btn btn-sm btn-outline-info" title="Reasignar ticket" onclick="AbrirReasignar(' + data + ', ' + row.AreaId + ')"><i class="fas fa-user-plus"></i></button>';
                        }

                        html += '</div>';
                        return html;
                    }
                }
            ],
            createdRow: function (row, data) {
                if (data.AgenteId && data.AgenteId === usuarioActualIdGlobal) {
                    $(row).addClass('ticket-mio');
                }
            },
            language: {
                url: "/Content/datatables/i18n/es-ES.json"
            }
        });
    }

    function ConsultarTodasTickets() {
        GetMVC("/Ticket/ConsultarTodasTickets", function (response) {
            var result = typeof response === 'string' ? JSON.parse(response) : response;

            if (result.IsSuccess && result.Response) {
                MapingPropertiesDataTable("tblTicket", result.Response);
            } else {
                MapingPropertiesDataTable("tblTicket", []);
                if (!result.IsSuccess) {
                    Swal.fire({
                        title: 'Error',
                        text: result.Message,
                        icon: 'error',
                        confirmButtonText: 'Aceptar',
                        background: 'white',
                        confirmButtonColor: '#4e73df'
                    });
                }
            }
        });
    }

    function ConsultarTicketsPorArea(areaId) {
        GetMVC("/Ticket/ConsultarTicketsPorArea/" + areaId, function (response) {
            var result = typeof response === 'string' ? JSON.parse(response) : response;

            if (result.IsSuccess && result.Response) {
                MapingPropertiesDataTable("tblTicket", result.Response);
            } else {
                MapingPropertiesDataTable("tblTicket", []);
                if (!result.IsSuccess) {
                    Swal.fire({
                        title: 'Error',
                        text: result.Message,
                        icon: 'error',
                        confirmButtonText: 'Aceptar',
                        background: 'white',
                        confirmButtonColor: '#4e73df'
                    });
                }
            }
        });
    }

    function RefrescarTabla() {
        var areaId = $("#ddlFiltroArea").val();
        if (areaId && areaId !== "") {
            ConsultarTicketsPorArea(areaId);
        } else {
            ConsultarTodasTickets();
        }
    }

    function badgeUrgencia(data) {
        switch (data) {
            case 1: return '<span class="badge bg-success">Baja</span>';
            case 2: return '<span class="badge bg-info">Media</span>';
            case 3: return '<span class="badge bg-warning">Alta</span>';
            case 4: return '<span class="badge bg-danger">Crítica</span>';
            default: return '---';
        }
    }

    function ToastExito(message) {
        Swal.fire({
            toast: true,
            position: 'top-end',
            icon: 'success',
            title: message || 'Operación realizada con éxito',
            showConfirmButton: false,
            timer: 2000,
            timerProgressBar: true,
            background: 'white',
            iconColor: '#4e73df'
        });
    }

    function ObtenerExtensionArchivo(nombre) {
        if (!nombre || nombre.lastIndexOf('.') === -1) return '';
        return nombre.substring(nombre.lastIndexOf('.') + 1).toLowerCase();
    }

    function ValidarArchivosEvidencia(files) {
        if (!files || files.length === 0) return true;

        var maxArchivos = evidenciaConfig.MaxArchivos || 3;
        var maxTamanoMB = evidenciaConfig.MaxTamanoMB || 3;
        var extensiones = evidenciaConfig.ExtensionesPermitidas || ["pdf", "jpg", "png"];

        if (files.length > maxArchivos) {
            Swal.fire({ title: 'Error', text: 'No puede adjuntar más de ' + maxArchivos + ' archivos a este ticket.', icon: 'error', confirmButtonText: 'Aceptar', background: 'white', confirmButtonColor: '#4e73df' });
            return false;
        }

        for (var i = 0; i < files.length; i++) {
            var file = files[i];

            if (file.size > maxTamanoMB * 1024 * 1024) {
                Swal.fire({ title: 'Error', text: 'El archivo "' + file.name + '" supera el tamaño máximo de ' + maxTamanoMB + ' MB.', icon: 'error', confirmButtonText: 'Aceptar', background: 'white', confirmButtonColor: '#4e73df' });
                return false;
            }

            var ext = ObtenerExtensionArchivo(file.name);
            if (extensiones.indexOf(ext) === -1) {
                Swal.fire({ title: 'Error', text: 'Extensión no permitida. Solo se aceptan: ' + extensiones.join(', ') + '.', icon: 'error', confirmButtonText: 'Aceptar', background: 'white', confirmButtonColor: '#4e73df' });
                return false;
            }
        }

        return true;
    }

    function SubirEvidencias(ticketId, files, onSuccess) {
        if (!files || files.length === 0) {
            if (typeof onSuccess === 'function') onSuccess();
            return;
        }

        Swal.fire({
            title: 'Subiendo evidencias...',
            text: 'Por favor espere',
            allowOutsideClick: false,
            didOpen: () => {
                Swal.showLoading();
            }
        });

        var parameters = [{ Name: 'ticketId', Value: ticketId }];
        for (var i = 0; i < files.length; i++) {
            parameters.push({ Name: 'archivos', Value: files[i] });
        }

        PostFileMVC('/Ticket/SubirEvidencia', parameters, function (response) {
            Swal.close();

            if (response && response.IsSuccess) {
                if (typeof onSuccess === 'function') {
                    onSuccess(response);
                } else {
                    ToastExito(response.Message || 'Evidencias subidas correctamente.');
                }
            } else {
                Swal.fire({
                    title: 'Error',
                    text: (response && response.Message) ? response.Message : 'No se pudieron subir las evidencias.',
                    icon: 'error',
                    confirmButtonText: 'Aceptar',
                    background: 'white',
                    confirmButtonColor: '#4e73df'
                });
            }
        });
    }

    function TomarTicket(id) {
        Swal.fire({
            title: '¿Tomar ticket?',
            text: 'Se te asignará este ticket y pasará a "En Progreso"',
            icon: 'question',
            showCancelButton: true,
            confirmButtonText: 'Sí, tomar',
            cancelButtonText: 'Cancelar',
            confirmButtonColor: '#4e73df',
            cancelButtonColor: '#858796'
        }).then((result) => {
            if (result.isConfirmed) {
                Swal.fire({
                    title: 'Tomando...',
                    text: 'Por favor espere',
                    allowOutsideClick: false,
                    didOpen: () => {
                        Swal.showLoading();
                    }
                });

                PostMVC('/Ticket/TomarTicket', { ticketId: id, comentario: null }, function (response) {
                    Swal.close();

                    if (response.IsSuccess) {
                        Swal.fire({
                            title: '¡Éxito!',
                            text: response.Message,
                            icon: 'success',
                            timer: 1500,
                            showConfirmButton: false,
                            background: 'white',
                            iconColor: '#4e73df'
                        }).then(() => {
                            RefrescarTabla();
                        });
                    } else {
                        Swal.fire({
                            title: 'Error',
                            text: response.Message,
                            icon: 'error',
                            confirmButtonText: 'Aceptar',
                            background: 'white',
                            confirmButtonColor: '#4e73df'
                        });
                    }
                });
            }
        });
    }

    function ResolverTicket(id) {
        Swal.fire({
            title: 'Resolver ticket',
            text: 'Describe la solución (obligatorio, máximo 300 caracteres)',
            input: 'textarea',
            inputPlaceholder: 'Describe la solución...',
            inputAttributes: {
                maxlength: 300
            },
            showCancelButton: true,
            confirmButtonText: 'Resolver',
            cancelButtonText: 'Cancelar',
            confirmButtonColor: '#4e73df',
            cancelButtonColor: '#858796',
            background: 'white',
            inputValidator: function (value) {
                if (!value || !value.trim()) {
                    return 'Debe escribir un comentario para resolver el ticket.';
                }
                if (value.length > 300) {
                    return 'El comentario no puede superar los 300 caracteres.';
                }
            }
        }).then((result) => {
            if (result.isConfirmed) {
                Swal.fire({
                    title: 'Resolviendo...',
                    text: 'Por favor espere',
                    allowOutsideClick: false,
                    didOpen: () => {
                        Swal.showLoading();
                    }
                });

                PostMVC('/Ticket/ResolverTicket', { ticketId: id, comentario: result.value }, function (response) {
                    Swal.close();

                    if (response.IsSuccess) {
                        ToastExito(response.Message);
                        RefrescarTabla();
                        AbrirSubirEvidencia(id);
                    } else {
                        Swal.fire({
                            title: 'Error',
                            text: response.Message,
                            icon: 'error',
                            confirmButtonText: 'Aceptar',
                            background: 'white',
                            confirmButtonColor: '#4e73df'
                        });
                    }
                });
            }
        });
    }

    function RechazarTicket(id) {
        Swal.fire({
            title: 'Rechazar ticket',
            text: 'Describe el motivo del rechazo (obligatorio, máximo 300 caracteres)',
            input: 'textarea',
            inputPlaceholder: 'Motivo del rechazo...',
            inputAttributes: {
                maxlength: 300
            },
            showCancelButton: true,
            confirmButtonText: 'Rechazar',
            cancelButtonText: 'Cancelar',
            confirmButtonColor: '#e74a3b',
            cancelButtonColor: '#858796',
            background: 'white',
            inputValidator: function (value) {
                if (!value || !value.trim()) {
                    return 'Debe escribir un comentario para rechazar el ticket.';
                }
                if (value.length > 300) {
                    return 'El comentario no puede superar los 300 caracteres.';
                }
            }
        }).then((result) => {
            if (result.isConfirmed) {
                Swal.fire({
                    title: 'Rechazando...',
                    text: 'Por favor espere',
                    allowOutsideClick: false,
                    didOpen: () => {
                        Swal.showLoading();
                    }
                });

                PostMVC('/Ticket/RechazarTicket', { ticketId: id, comentario: result.value }, function (response) {
                    Swal.close();

                    if (response.IsSuccess) {
                        ToastExito(response.Message);
                        RefrescarTabla();
                        AbrirSubirEvidencia(id);
                    } else {
                        Swal.fire({
                            title: 'Error',
                            text: response.Message,
                            icon: 'error',
                            confirmButtonText: 'Aceptar',
                            background: 'white',
                            confirmButtonColor: '#4e73df'
                        });
                    }
                });
            }
        });
    }

    function CerrarTicket(id) {
        Swal.fire({
            title: 'Cerrar ticket',
            text: 'Describe el motivo del cierre (obligatorio, máximo 300 caracteres)',
            input: 'textarea',
            inputPlaceholder: 'Motivo del cierre...',
            inputAttributes: {
                maxlength: 300
            },
            showCancelButton: true,
            confirmButtonText: 'Cerrar',
            cancelButtonText: 'Cancelar',
            confirmButtonColor: '#4e73df',
            cancelButtonColor: '#858796',
            background: 'white',
            inputValidator: function (value) {
                if (!value || !value.trim()) {
                    return 'Debe escribir un comentario para cerrar el ticket.';
                }
                if (value.length > 300) {
                    return 'El comentario no puede superar los 300 caracteres.';
                }
            }
        }).then((result) => {
            if (result.isConfirmed) {
                Swal.fire({
                    title: 'Cerrando...',
                    text: 'Por favor espere',
                    allowOutsideClick: false,
                    didOpen: () => {
                        Swal.showLoading();
                    }
                });

                PostMVC('/Ticket/CerrarTicket', { ticketId: id, comentario: result.value }, function (response) {
                    Swal.close();

                    if (response.IsSuccess) {
                        ToastExito(response.Message);
                        RefrescarTabla();
                    } else {
                        Swal.fire({
                            title: 'Error',
                            text: response.Message,
                            icon: 'error',
                            confirmButtonText: 'Aceptar',
                            background: 'white',
                            confirmButtonColor: '#4e73df'
                        });
                    }
                });
            }
        });
    }

    function RetomarTicket(id) {
        Swal.fire({
            title: '¿Retomar ticket?',
            text: 'El ticket volverá a "En Progreso" y se te asignará.',
            icon: 'question',
            showCancelButton: true,
            confirmButtonText: 'Sí, retomar',
            cancelButtonText: 'Cancelar',
            confirmButtonColor: '#4e73df',
            cancelButtonColor: '#858796'
        }).then((result) => {
            if (result.isConfirmed) {
                Swal.fire({
                    title: 'Retomando...',
                    text: 'Por favor espere',
                    allowOutsideClick: false,
                    didOpen: () => {
                        Swal.showLoading();
                    }
                });

                PostMVC('/Ticket/RetomarTicket', { ticketId: id }, function (response) {
                    Swal.close();

                    if (response.IsSuccess) {
                        ToastExito(response.Message);
                        RefrescarTabla();
                    } else {
                        Swal.fire({
                            title: 'Error',
                            text: response.Message,
                            icon: 'error',
                            confirmButtonText: 'Aceptar',
                            background: 'white',
                            confirmButtonColor: '#4e73df'
                        });
                    }
                });
            }
        });
    }

    function VerTicket(id) {
        if (typeof tablaTicket === 'undefined' || !tablaTicket) {
            return;
        }

        var row = tablaTicket.rows().data().toArray().find(function (r) {
            return r.Id === id;
        });

        if (!row) {
            return;
        }

        $("#detTitulo").text(row.Titulo || '---');
        $("#detArea").text(row.AreaNombre || '---');
        $("#detCategoria").text(row.CategoriaNombre || '---');
        $("#detSubcategoria").text(row.SubcategoriaNombre || '---');
        $("#detUrgencia").html(badgeUrgencia(row.Urgencia));
        $("#detEstatus").html(row.EstatusColor
            ? '<span class="badge" style="background-color: ' + row.EstatusColor + '; color: white;">' + row.EstatusNombre + '</span>'
            : (row.EstatusNombre || '---'));
        $("#detAgente").text(row.AgenteNombre ? row.AgenteNombre + ' ' + (row.AgenteApellido || '') : '---');
        $("#detCreadoPor").text(row.CreadoPor || '---');
        $("#detFechaCreacion").text(row.FechaCreacion ? new Date(row.FechaCreacion).toLocaleString() : '---');
        $("#detDescripcion").text(row.Descripcion || '---');

        if (typeof CargarHistorial === 'function') {
            CargarHistorial(id);
        }

        ticketDetalleActualId = id;

        if (typeof CargarEvidencias === 'function') {
            CargarEvidencias(id);
        }

        bootstrap.Modal.getOrCreateInstance(document.getElementById('modalDetalleTicket')).show();
    }

    function AbrirReasignar(id, areaId) {
        $("#ticketIdReasignar").val(id);
        $("#comentarioReasignar").val('');
        $("#ddlUsuarioReasignar").empty().append('<option value="">Seleccione un usuario</option>');

        GetMVC('/Ticket/ObtenerUsuariosArea?areaId=' + areaId, function (response) {
            var result = typeof response === 'string' ? JSON.parse(response) : response;

            if (result.IsSuccess && result.Response) {
                result.Response.forEach(function (u) {
                    $("#ddlUsuarioReasignar").append('<option value="' + u.Id + '">' + u.Nombre + ' ' + (u.Apellido || '') + '</option>');
                });
            }
        });

        bootstrap.Modal.getOrCreateInstance(document.getElementById('modalReasignarTicket')).show();
    }
</script>
