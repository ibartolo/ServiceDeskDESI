﻿@model ServiceDeskDESIEntities.Tickets.Ticket
@{
    ViewBag.Title = "Tickets";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.1/jquery.validate.min.js"></script>
<script src="https://cdn.datatables.net/2.3.7/js/dataTables.js"></script>
<link href="https://cdn.datatables.net/2.3.7/css/dataTables.dataTables.css" rel="stylesheet" />

<div class="form-section">
    @if (ViewBag.ErrorMessage != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-circle"></i> @ViewBag.ErrorMessage
            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                <span aria-hidden="true">&times;</span>
            </button>
        </div>
    }

    <h3 class="section-title"><i class="fas fa-ticket-alt me-2"></i>Tickets</h3>

    <form id="frmTicket" name="frmTicket" method="post">
        @Html.HiddenFor(x => x.Id)
        @Html.HiddenFor(x => x.CreadoPor)
        @Html.HiddenFor(x => x.FechaCreacion)
        @Html.HiddenFor(x => x.ModificadoPor)
        @Html.HiddenFor(x => x.FechaModificacion)
        @Html.HiddenFor(x => x.Estatus)

        <div class="row">
            <div class="col-md-4">
                <div class="mb-3">
                    <label>Área:</label>
                    @Html.DropDownListFor(x => x.Area.Id, new SelectList(ViewBag.Areas, "Id", "Nombre"), "Seleccione un área", new { @class = "form-control", id = "ddlArea" })
                </div>
            </div>
            <div class="col-md-4">
                <div class="mb-3">
                    <label>Categoría:</label>
                    <select id="ddlCategoria" class="form-control">
                        <option value="">Seleccione una categoría</option>
                    </select>
                    @Html.HiddenFor(x => x.Categoria.Id)
                </div>
            </div>
            <div class="col-md-4">
                <div class="mb-3">
                    <label>Subcategoría:</label>
                    <select id="ddlSubcategoria" class="form-control">
                        <option value="">Seleccione una subcategoría</option>
                    </select>
                    @Html.HiddenFor(x => x.Subcategoria.Id)
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-4">
                <div class="mb-3">
                    <label>Urgencia:</label>
                    <select id="ddlUrgencia" class="form-control">
                        <option value="">Seleccione un nivel</option>
                        <option value="1">Baja</option>
                        <option value="2">Media</option>
                        <option value="3">Alta</option>
                        <option value="4">Crítica</option>
                    </select>
                    @Html.HiddenFor(x => x.Urgencia)
                </div>
            </div>
            <div class="col-md-8">
                <div class="mb-3">
                    <label>Título:</label>
                    @Html.TextBoxFor(x => x.Titulo, new { @class = "form-control", placeholder = "Título del ticket" })
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-12">
                <div class="mb-3">
                    <label>Descripción:</label>
                    @Html.TextAreaFor(x => x.Descripcion, new { @class = "form-control", placeholder = "Descripción detallada del problema", rows = 5 })
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-12">
                <div class="mb-3">
                    <input type="button" value="Guardar" class="btn btn-success" onclick="GuardarActualizarTicket()" />
                    <a href="/Ticket/Index" class="btn btn-warning">Cancelar</a>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-12">
                <div class="mb-3">
                    <label>Filtrar por Área:</label>
                    @Html.DropDownList("ddlFiltroArea", new SelectList(ViewBag.Areas, "Id", "Nombre"), "Todas las áreas", new { @class = "form-control w-25", id = "ddlFiltroArea" })
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-12 table-responsive">
                <div class="mb-3">
                    <table id="tblTicket" class="table table-striped">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Título</th>
                                <th>Área</th>
                                <th>Categoría</th>
                                <th>Subcategoría</th>
                                <th>Urgencia</th>
                                <th>Fecha Creación</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </form>
</div>

<script>
    var tablaTicket;

    $(function () {
        $("#frmTicket").validate({
            rules: {
                "Titulo": {
                    required: true,
                    maxlength: 250
                },
                "Descripcion": {
                    required: true
                }
            },
            messages: {
                "Titulo": {
                    required: "El campo 'Título' es requerido.",
                    maxlength: "El título no puede superar los 250 caracteres."
                },
                "Descripcion": {
                    required: "El campo 'Descripción' es requerido."
                }
            },
            errorElement: "span",
            errorClass: "text-danger",
            highlight: function (element) {
                $(element).addClass("is-invalid").removeClass("is-valid");
            },
            unhighlight: function (element) {
                $(element).removeClass("is-invalid").addClass("is-valid");
            },
            errorPlacement: function (error, element) {
                error.insertAfter(element);
            }
        });
    });

    $(document).ready(function () {
        // Inicializar DataTable
        InicializarDataTable();

        // Cargar tabla según el filtro actual
        var areaId = $("#ddlFiltroArea").val();
        if (areaId && areaId !== "") {
            ConsultarTicketsPorArea(areaId);
        } else {
            ConsultarTodasTickets();
        }

        // Eventos
        $("#ddlFiltroArea").change(function () {
            var areaId = $(this).val();
            if (areaId && areaId !== "") {
                ConsultarTicketsPorArea(areaId);
            } else {
                ConsultarTodasTickets();
            }
        });

        $("#ddlArea").change(function () {
            var areaId = $(this).val();

            // Limpiar categorías y subcategorías
            $("#ddlCategoria").empty().append('<option value="">Seleccione una categoría</option>');
            $("#ddlSubcategoria").empty().append('<option value="">Seleccione una subcategoría</option>');
            $("#Categoria_Id").val('');
            $("#Subcategoria_Id").val('');

            if (areaId) {
                // Primera llamada: obtener todas las categorías por área
                GetMVC('/Ticket/ObtenerCategoriasPorArea?areaId=' + areaId, function (response) {
                    var result = typeof response === 'string' ? JSON.parse(response) : response;
                    if (result.IsSuccess && result.Response) {
                        var todasCategorias = result.Response;
                        var ddlCategoria = $("#ddlCategoria");

                        // Filtrar solo categorías padre (CategoriaPadre === null)
                        var categoriasPadre = todasCategorias.filter(function (c) {
                            return c.CategoriaPadre === null;
                        });

                        categoriasPadre.forEach(function (c) {
                            ddlCategoria.append('<option value="' + c.Id + '">' + c.Nombre + '</option>');
                        });
                    }
                });
            }
        });

        $("#ddlCategoria").change(function () {
            var categoriaId = $(this).val();

            // Limpiar subcategorías
            $("#ddlSubcategoria").empty().append('<option value="">Seleccione una subcategoría</option>');
            $("#Subcategoria_Id").val('');

            if (categoriaId) {
                // Segunda llamada: obtener subcategorías por categoría padre
                GetMVC('/Ticket/ObtenerSubcategoriasPorCategoria?categoriaId=' + categoriaId, function (result) {
                    if (result.IsSuccess && result.Response) {
                        var subcategorias = result.Response;
                        var ddlSubcategoria = $("#ddlSubcategoria");

                        subcategorias.forEach(function (s) {
                            ddlSubcategoria.append('<option value="' + s.Id + '">' + s.Nombre + '</option>');
                        });
                    }
                });
            }
        });
    });

    function InicializarDataTable() {
        tablaTicket = $('#tblTicket').DataTable({
            columns: [
                { data: 'Id', title: 'ID', visible: false },
                { data: 'Titulo', title: 'Título' },
                { data: 'Area.Nombre', title: 'Área' },
                { data: 'Categoria.Nombre', title: 'Categoría' },
                { data: 'Subcategoria.Nombre', title: 'Subcategoría', defaultContent: '---' },
                {
                    data: 'Urgencia',
                    title: 'Urgencia',
                    render: function (data) {
                        switch(data) {
                            case 1: return '<span class="badge bg-success">Baja</span>';
                            case 2: return '<span class="badge bg-info">Media</span>';
                            case 3: return '<span class="badge bg-warning">Alta</span>';
                            case 4: return '<span class="badge bg-danger">Crítica</span>';
                            default: return '---';
                        }
                    }
                },
                {
                    data: 'FechaCreacion',
                    title: 'Fecha Creación',
                    render: function (data) {
                        if (data) {
                            var fecha = new Date(data);
                            return fecha.toLocaleDateString();
                        }
                        return '---';
                    }
                },
                {
                    data: 'Id', title: 'Acciones', render: function (data) {
                        return '<div class="d-flex gap-3">' +
                            '<button class="btn btn-sm btn-outline-primary" onclick="EditarTicket(' + data + ')"><i class="fas fa-edit"></i></button>' +
                            '<button class="btn btn-sm btn-outline-danger" onclick="EliminarTicket(' + data + ')"><i class="fas fa-trash-alt"></i></button>' +
                            '</div>';
                    }
                }
            ],
            language: {
                url: "/Content/datatables/i18n/es-ES.json"
            }
        });
    }

    function CargarCategoriasPorArea(areaId) {
        GetMVC("/Ticket/ObtenerCategoriasPorArea/" + areaId, function (response) {
            var result = typeof response === 'string' ? JSON.parse(response) : response;
            if (result.IsSuccess && result.Response) {
                var categorias = result.Response;
                var ddl = $("#ddlCategoria");
                ddl.empty();
                ddl.append('<option value="">Seleccione una categoría</option>');

                // Filtrar solo categorías principales (sin padre)
                var principales = categorias.filter(function (c) {
                    return c.CategoriaPadre === null;
                });

                principales.forEach(function (c) {
                    ddl.append('<option value="' + c.Id + '">' + c.Nombre + '</option>');
                });
            }
        });
    }

    function CargarSubcategorias(categoriaId) {
        GetMVC("/Ticket/ObtenerSubcategoriasPorCategoria?categoriaId=" + categoriaId, function (response) {
            var result = typeof response === 'string' ? JSON.parse(response) : response;
            if (result.IsSuccess && result.Response) {
                var subcategorias = result.Response;
                var ddl = $("#ddlSubcategoria");
                ddl.empty();
                ddl.append('<option value="">Seleccione una subcategoría</option>');

                subcategorias.forEach(function (s) {
                    ddl.append('<option value="' + s.Id + '">' + s.Nombre + '</option>');
                });
            }
        });
    }

    function ConsultarTodasTickets() {
        GetMVC("/Ticket/ConsultarTodasTickets", function (response) {
            var result = typeof response === 'string' ? JSON.parse(response) : response;

            if (result.IsSuccess && result.Response) {
                MapingPropertiesDataTable("tblTicket", result.Response);
            } else {
                MapingPropertiesDataTable("tblTicket", []);
                if (!result.IsSuccess) {
                    Swal.fire({
                        title: 'Error',
                        text: result.Message,
                        icon: 'error',
                        confirmButtonText: 'Aceptar',
                        background: 'white',
                        confirmButtonColor: '#4e73df'
                    });
                }
            }
        });
    }

    function ConsultarTicketsPorArea(areaId) {
        GetMVC("/Ticket/ConsultarTicketsPorArea/" + areaId, function (response) {
            var result = typeof response === 'string' ? JSON.parse(response) : response;

            if (result.IsSuccess && result.Response) {
                MapingPropertiesDataTable("tblTicket", result.Response);
            } else {
                MapingPropertiesDataTable("tblTicket", []);
                if (!result.IsSuccess) {
                    Swal.fire({
                        title: 'Error',
                        text: result.Message,
                        icon: 'error',
                        confirmButtonText: 'Aceptar',
                        background: 'white',
                        confirmButtonColor: '#4e73df'
                    });
                }
            }
        });
    }

    function GuardarActualizarTicket() {
        if ($("#frmTicket").valid()) {
            // Validar área
            if (!$("#ddlArea").val()) {
                Swal.fire({
                    title: 'Error',
                    text: 'Debe seleccionar un área',
                    icon: 'error',
                    confirmButtonText: 'Aceptar',
                    background: 'white',
                    confirmButtonColor: '#4e73df'
                });
                return;
            }

            // Validar categoría
            if (!$("#ddlCategoria").val()) {
                Swal.fire({
                    title: 'Error',
                    text: 'Debe seleccionar una categoría',
                    icon: 'error',
                    confirmButtonText: 'Aceptar',
                    background: 'white',
                    confirmButtonColor: '#4e73df'
                });
                return;
            }

            // Validar subcategoría
            if (!$("#ddlSubcategoria").val()) {
                Swal.fire({
                    title: 'Error',
                    text: 'Debe seleccionar una subcategoría',
                    icon: 'error',
                    confirmButtonText: 'Aceptar',
                    background: 'white',
                    confirmButtonColor: '#4e73df'
                });
                return;
            }

            // Validar urgencia
            if (!$("#ddlUrgencia").val()) {
                Swal.fire({
                    title: 'Error',
                    text: 'Debe seleccionar un nivel de urgencia',
                    icon: 'error',
                    confirmButtonText: 'Aceptar',
                    background: 'white',
                    confirmButtonColor: '#4e73df'
                });
                return;
            }

            Swal.fire({
                title: 'Guardando...',
                text: 'Por favor espere',
                allowOutsideClick: false,
                didOpen: () => {
                    Swal.showLoading();
                }
            });

            var ticket = {
                Id: $("#Id").val() || 0,
                Area: { Id: parseInt($("#ddlArea").val()) },
                Categoria: { Id: parseInt($("#ddlCategoria").val()) },
                Subcategoria: { Id: parseInt($("#ddlSubcategoria").val()) },
                Urgencia: parseInt($("#ddlUrgencia").val()),
                Titulo: $("#Titulo").val(),
                Descripcion: $("#Descripcion").val(),
                CreadoPor: $("#CreadoPor").val(),
                FechaCreacion: $("#FechaCreacion").val(),
                ModificadoPor: $("#ModificadoPor").val() || null,
                FechaModificacion: null,
                Estatus: true
            };

            PostMVC('/Ticket/GuardarOActualizarTicket', ticket, function (response) {
                Swal.close();

                if (response.IsSuccess) {
                    Swal.fire({
                        title: '¡Éxito!',
                        text: response.Message,
                        icon: 'success',
                        timer: 1500,
                        showConfirmButton: false,
                        background: 'white',
                        iconColor: '#4e73df'
                    }).then(() => {
                        window.location.href = '/Ticket/Index';
                    });
                } else {
                    Swal.fire({
                        title: 'Error',
                        text: response.Message,
                        icon: 'error',
                        confirmButtonText: 'Aceptar',
                        background: 'white',
                        confirmButtonColor: '#4e73df'
                    });
                }
            });
        }
    }

    function EditarTicket(id) {
        window.location.href = '/Ticket/Index/' + id;
    }

    function EliminarTicket(id) {
        Swal.fire({
            title: '¿Está seguro?',
            text: 'Esta acción eliminará lógicamente el registro',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonText: 'Sí, eliminar',
            cancelButtonText: 'Cancelar',
            confirmButtonColor: '#e74a3b',
            cancelButtonColor: '#858796'
        }).then((result) => {
            if (result.isConfirmed) {
                Swal.fire({
                    title: 'Eliminando...',
                    text: 'Por favor espere',
                    allowOutsideClick: false,
                    didOpen: () => {
                        Swal.showLoading();
                    }
                });

                var ticket = {
                    Id: id,
                    ModificadoPor: $("#ModificadoPor").val() || "system",
                    FechaModificacion: new Date().toISOString()
                };

                PostMVC('/Ticket/EliminarTicket', ticket, function (response) {
                    Swal.close();

                    if (response.IsSuccess) {
                        Swal.fire({
                            title: '¡Eliminado!',
                            text: response.Message,
                            icon: 'success',
                            timer: 1500,
                            showConfirmButton: false,
                            background: 'white',
                            iconColor: '#4e73df'
                        }).then(() => {
                            var areaId = $("#ddlFiltroArea").val();
                            if (areaId && areaId !== "") {
                                ConsultarTicketsPorArea(areaId);
                            } else {
                                ConsultarTodasTickets();
                            }
                            $("#frmTicket")[0].reset();
                            $("#Id").val(0);
                        });
                    } else {
                        Swal.fire({
                            title: 'Error',
                            text: response.Message,
                            icon: 'error',
                            confirmButtonText: 'Aceptar',
                            background: 'white',
                            confirmButtonColor: '#4e73df'
                        });
                    }
                });
            }
        });
    }
</script>