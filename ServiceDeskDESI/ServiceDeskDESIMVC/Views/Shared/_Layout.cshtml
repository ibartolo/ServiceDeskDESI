<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Service Desk DESI - @ViewBag.Title</title>

    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Font Awesome 6 -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- FullCalendar CSS (comentado pero disponible) -->
    <link href="https://cdn.jsdelivr.net/npm/fullcalendar@5.11.3/main.min.css" rel="stylesheet">
    <!-- Chart.js CSS (comentado pero disponible) -->
    <link href="https://cdn.jsdelivr.net/npm/chart.js@3.9.1/dist/chart.min.css" rel="stylesheet">
    <!-- SweetAlert2 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css" rel="stylesheet">

    <!-- ========================================= -->
    <!-- ESTILOS GENERALES DEL TEMPLATE -->
    <!-- ========================================= -->
    <link href="~/CSS/Comun/TemplatePage.css" rel="stylesheet" />

    <!-- ========================================= -->
    <!-- ESTILOS ESPECÍFICOS PARA VIDEOS Y GRÁFICAS -->
    <!-- ========================================= -->
    <link href="~/CSS/Comun/TemplateVideo.css" rel="stylesheet" />
    <!--<link href="~/CSS/Comun/TemplateGraficas.css" rel="stylesheet" />
    <link href="~/CSS/Comun/TemplateCalendario.css" rel="stylesheet" />-->
    <link href="~/CSS/Comun/TemplateTarjetas.css" rel="stylesheet" />

    <!-- Nuevo CSS: estilos para módulos deshabilitados -->
    <link href="~/CSS/Comun/TemplateDisabled.css" rel="stylesheet" />

    <!-- ========================================= -->
    <!-- SCRIPTS - jQuery primero, luego Bootstrap -->
    <!-- ========================================= -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Scripts comentados (disponibles para cuando se necesiten) -->
    <!--<script src="https://cdn.jsdelivr.net/npm/fullcalendar@5.11.3/main.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@3.9.1/dist/chart.min.js"></script>-->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/Scripts/Comun/Comun.js"></script>

    <!-- ========================================= -->
    <!-- SCRIPT PARA FUNCIONALIDAD DEL SIDEBAR Y MENÚS -->
    <!-- ========================================= -->
    <script>
        $(document).ready(function () {
            console.log("jQuery cargado correctamente - versión: " + $.fn.jquery);

            // =========================================
            // FUNCIONALIDAD DEL SIDEBAR (COLLAPSE)
            // =========================================
            $('#sidebarCollapse').on('click', function () {
                $('#sidebar').toggleClass('active');
                $('#content').toggleClass('active');
                console.log('Sidebar toggled');
            });

            // =========================================
            // MANEJO DE SUBMENÚS DESPLEGABLES
            // =========================================
            $('.has-arrow').on('click', function (e) {
                e.preventDefault();
                e.stopPropagation();

                const $parent = $(this).parent();

                // Cerrar otros submenús abiertos (opcional - comentar si no se desea)
                $('.components li').not($parent).removeClass('active');

                // Toggle del submenú actual
                $parent.toggleClass('active');

                console.log('Submenú toggled:', $parent.find('.menu-text').text());
            });

            // =========================================
            // MARCAR ENLACES SIN REDIRECCIÓN COMO DESHABILITADOS
            // =========================================
            // Añade la clase `disabled-module` a todos los enlaces en .components con href="#".
            // Para enlaces que NO son padres (.has-arrow) se evita el click y se añade aria-disabled.
            $('.components a[href="#"]').each(function () {
                var $a = $(this);
                $a.addClass('disabled-module');

                if (!$a.hasClass('has-arrow')) {
                    // Marcar como realmente no accionable (legend/tooltip accesible)
                    $a.attr('aria-disabled', 'true');
                    $a.on('click.disabled', function (ev) {
                        ev.preventDefault();
                        ev.stopPropagation();
                        // opcional: mostrar un tooltip o Swal indicando "Módulo en desarrollo"
                        // Swal.fire('Módulo en desarrollo', '', 'info');
                    });
                }
            });

            // =========================================
            // CERRAR SUBMENÚS AL HACER CLIC FUERA
            // =========================================
            $(document).on('click', function (e) {
                if (!$(e.target).closest('.components li').length) {
                    $('.components li').removeClass('active');
                }
            });

            // =========================================
            // MANEJO DE RESPONSIVE - CERRAR SIDEBAR EN MÓVIL AL SELECCIONAR OPCIÓN
            // =========================================
            $('.components a').on('click', function () {
                if ($(window).width() <= 992) {
                    if (!$(this).hasClass('has-arrow')) {
                        $('#sidebar').removeClass('active');
                        $('#content').removeClass('active');
                    }
                }
            });

            // =========================================
            // AJUSTE EN CAMBIO DE TAMAÑO DE VENTANA
            // =========================================
            $(window).on('resize', function () {
                if ($(window).width() > 992) {
                    $('#sidebar, #content').removeClass('active');
                }
            });

            // =========================================
            // MARCAR ENLACES SIN REDIRECCIÓN COMO DESHABILITADOS
            // =========================================
            $('.components a[href="#"]').each(function () {
                var $a = $(this);

                // Si es un padre de submenú (tiene .has-arrow) no lo marcamos como "disabled"
                if ($a.hasClass('has-arrow')) {
                    // Asegurar que no tenga la clase por algún motivo previo
                    $a.removeClass('disabled-module');
                    $a.removeAttr('aria-disabled');
                    $a.off('click.disabled');
                } else {
                    // Solo marcar enlaces leaf (sin submenú) que usan href="#"
                    $a.addClass('disabled-module');
                    $a.attr('aria-disabled', 'true');
                    $a.on('click.disabled', function (ev) {
                        ev.preventDefault();
                        ev.stopPropagation();
                        // opcional: mostrar aviso: Swal.fire('Módulo en desarrollo', '', 'info');
                    });
                }
            });

            // Verificar SweetAlert2 disponible
            if (typeof Swal !== 'undefined') {
                console.log('SweetAlert2 disponible');
            }
        });
    </script>

    <!-- ========================================= -->
    <!-- SCRIPT PARA EL CALENDARIO Y GRÁFICAS (COMENTADO) -->
    <!-- ========================================= -->
    <!--<script src="~/Scripts/Comun/Calendario.js"></script>-->
</head>
<body>
    <div class="wrapper">
        <!-- ========================================= -->
        <!-- SIDEBAR - Service Desk DESI -->
        <!-- ========================================= -->
        <nav id="sidebar">
            <div class="sidebar-header">
                <i class="fas fa-headset" style="font-size: 3rem; color: white;"></i>
                <h3>Service Desk DESI</h3>
                <p>Sistema de Gestión de Tickets</p>
            </div>

            <ul class="components">
                <li>
                    <a href="/Home/Index">
                        <i class="fas fa-tachometer-alt"></i>
                        <span class="menu-text">Dashboard</span>
                    </a>
                </li>
                <li>
                    <a href="#" class="has-arrow">
                        <i class="fas fa-ticket-alt"></i>
                        <span class="menu-text">Tickets</span>
                    </a>
                    <ul>
                        <li><a href="#" class="disabled-module"><i class="fas fa-list"></i> Ver Tickets</a></li>
                        <li><a href="#" class="disabled-module"><i class="fas fa-plus"></i> Nuevo Ticket</a></li>
                        <li><a href="#" class="disabled-module"><i class="fas fa-clock"></i> Pendientes</a></li>
                        <li><a href="#" class="disabled-module"><i class="fas fa-check-circle"></i> Resueltos</a></li>
                    </ul>
                </li>
                <li>
                    <a href="/Ticket/Index">
                        <i class="fas fa-ticket-alt"></i>
                        <span class="menu-text">Tickets</span>
                    </a>
                </li>
                <li>
                    <a href="#" class="has-arrow">
                        <i class="fas fa-users"></i>
                        <span class="menu-text">Usuarios</span>
                    </a>
                    <ul>
                        <li><a href="#" class="disabled-module"><i class="fas fa-user"></i> Agentes</a></li>
                        <li><a href="#" class="disabled-module"><i class="fas fa-user-tie"></i> Administradores</a></li>
                        <li><a href="#" class="disabled-module"><i class="fas fa-user-plus"></i> Nuevo Usuario</a></li>
                    </ul>
                </li>
                <!--<li>
                    <a href="#" class="has-arrow">
                        <i class="fas fa-folder"></i>
                        <span class="menu-text">Categorías</span>
                    </a>
                    <ul>
                        <li><a href="#"><i class="fas fa-laptop"></i> Hardware</a></li>
                        <li><a href="#"><i class="fas fa-code"></i> Software</a></li>
                        <li><a href="#"><i class="fas fa-network-wired"></i> Redes</a></li>
                        <li><a href="#"><i class="fas fa-database"></i> Base de Datos</a></li>
                    </ul>
                </li>-->
                <li>
                    <a href="#" class="has-arrow">
                        <i class="fas fa-book"></i>
                        <span class="menu-text">Catálogos</span>
                    </a>
                    <ul>
                        <li><a href="/Catalogs/Active"><i class="fas fa-building"></i> Activos</a></li>
                        <li><a href="/Catalogs/Model"><i class="fas fa-building"></i> Modelo</a></li>
                        <li><a href="/Catalogs/Mark"><i class="fas fa-building"></i> Marca</a></li>
                        <li><a href="/Catalogs/TypeActive"><i class="fas fa-building"></i> Tipo De Activos</a></li>
                        <li><a href="/Catalogs/Company"><i class="fas fa-building"></i> Compañías</a></li>
                        <li><a href="/Catalogs/WorkArea"><i class="fas fa-chart-simple"></i> Áreas</a></li>
                        <li><a href="/Catalogs/Branch"><i class="fas fa-store"></i> Sucursales</a></li>
                        <li><a href="/Catalogs/Category"><i class="fas fa-folder-tree"></i> Categorías</a></li>
                    </ul>
                </li>
                <li>
                    <a href="#" class="disabled-module">
                        <i class="fas fa-calendar-alt"></i>
                        <span class="menu-text">Calendario</span>
                    </a>
                </li>
                <li>
                    <a href="#" class="disabled-module">
                        <i class="fas fa-video"></i>
                        <span class="menu-text">Videos Tutoriales</span>
                    </a>
                </li>
                <li>
                    <a href="#" class="disabled-module">
                        <i class="fas fa-chart-bar"></i>
                        <span class="menu-text">Reportes</span>
                    </a>
                </li>
                <li>
                    <a href="#" class="has-arrow">
                        <i class="fas fa-cog"></i>
                        <span class="menu-text">Configuración</span>
                    </a>
                    <ul>
                        <li><a href="#" class="disabled-module"><i class="fas fa-sliders-h"></i> General</a></li>
                        <li><a href="#" class="disabled-module"><i class="fas fa-bell"></i> Notificaciones</a></li>
                        <li><a href="#" class="disabled-module"><i class="fas fa-shield-alt"></i> Seguridad</a></li>
                    </ul>
                </li>
            </ul>
        </nav>

        <!-- ========================================= -->
        <!-- CONTENIDO PRINCIPAL -->
        <!-- ========================================= -->
        <div id="content">
            <!-- Navbar superior con usuario autenticado a la derecha -->
            <nav class="navbar-top">
                <button type="button" id="sidebarCollapse" class="menu-toggle">
                    <i class="fas fa-bars"></i>
                </button>

                <div class="user-menu">
                    <div class="user-details">
                        <div class="user-name">@ServiceDeskDESIMVC.Helpers.SessionHelper.GetSessionUser().UserName</div>
                    </div>
                    <div class="user-avatar">
                        @{
                            var usuario = ServiceDeskDESIMVC.Helpers.SessionHelper.GetSessionUser();
                            if (!string.IsNullOrEmpty(usuario.ProfileImage) && System.IO.File.Exists(Server.MapPath(usuario.ProfileImage)))
                            {
                                <img src="@usuario.ProfileImage" alt="Foto de perfil" class="rounded-circle" style="width: 40px; height: 40px; object-fit: cover;" />
                            }
                            else
                            {
                                @Html.Raw(usuario.UserAvatar)
                            }
                        }
                    </div>
                    <div class="dropdown">
                        <button class="btn btn-light dropdown-toggle" type="button" data-bs-toggle="dropdown">
                            <i class="fas fa-chevron-down"></i>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li><a class="dropdown-item" href="/User/MyProfile"><i class="fas fa-user me-2"></i> Perfil</a></li>
                            <li><a class="dropdown-item" href="#"><i class="fas fa-cog me-2"></i> Configuración</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li><a class="dropdown-item" href="/Home/LogOut"><i class="fas fa-sign-out-alt me-2"></i> Cerrar Sesión</a></li>
                        </ul>
                    </div>
                </div>
            </nav>

            <!-- Contenido principal -->
            <div class="main-content">
                @RenderBody()
            </div>
        </div>
    </div>
</body>
</html>