<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Service Desk DESI - @ViewBag.Title</title>

    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Font Awesome 6 -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- FullCalendar CSS -->
    <link href="https://cdn.jsdelivr.net/npm/fullcalendar@5.11.3/main.min.css" rel="stylesheet">
    <!-- Chart.js CSS -->
    <link href="https://cdn.jsdelivr.net/npm/chart.js@3.9.1/dist/chart.min.css" rel="stylesheet">
    <!-- SweetAlert2 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css" rel="stylesheet">

    <!-- ========================================= -->
    <!-- ESTILOS GENERALES DEL TEMPLATE -->
    <!-- ========================================= -->
    <link href="~/CSS/Comun/TemplatePage.css" rel="stylesheet" />

    <!-- ========================================= -->
    <!-- ESTILOS ESPECÍFICOS PARA VIDEOS Y GRÁFICAS -->
    <!-- ========================================= -->
    <link href="~/CSS/Comun/TemplateVideo.css" rel="stylesheet" />
    <link href="~/CSS/Comun/TemplateGraficas.css" rel="stylesheet" />
    <link href="~/CSS/Comun/TemplateCalendario.css" rel="stylesheet" />
    <link href="~/CSS/Comun/TemplateTarjetas.css" rel="stylesheet" />

</head>
<body>
    <div class="wrapper">
        <!-- ========================================= -->
        <!-- SIDEBAR - Service Desk DESI -->
        <!-- ========================================= -->
        <nav id="sidebar">
            <div class="sidebar-header">
                <i class="fas fa-headset" style="font-size: 3rem; color: white;"></i>
                <h3>Service Desk DESI</h3>
                <p>Sistema de Gestión de Tickets</p>
            </div>

            <ul class="components">
                <li class="active">
                    <a href="#" class="has-arrow">
                        <i class="fas fa-tachometer-alt"></i>
                        <span class="menu-text">Dashboard</span>
                    </a>
                    <ul>
                        <li><a href="#"><i class="fas fa-chart-pie"></i> Resumen</a></li>
                        <li><a href="#"><i class="fas fa-chart-line"></i> Estadísticas</a></li>
                    </ul>
                </li>
                <li>
                    <a href="#" class="has-arrow">
                        <i class="fas fa-ticket-alt"></i>
                        <span class="menu-text">Tickets</span>
                    </a>
                    <ul>
                        <li><a href="#"><i class="fas fa-list"></i> Ver Tickets</a></li>
                        <li><a href="#"><i class="fas fa-plus"></i> Nuevo Ticket</a></li>
                        <li><a href="#"><i class="fas fa-clock"></i> Pendientes</a></li>
                        <li><a href="#"><i class="fas fa-check-circle"></i> Resueltos</a></li>
                    </ul>
                </li>
                <li>
                    <a href="#" class="has-arrow">
                        <i class="fas fa-users"></i>
                        <span class="menu-text">Usuarios</span>
                    </a>
                    <ul>
                        <li><a href="#"><i class="fas fa-user"></i> Agentes</a></li>
                        <li><a href="#"><i class="fas fa-user-tie"></i> Administradores</a></li>
                        <li><a href="#"><i class="fas fa-user-plus"></i> Nuevo Usuario</a></li>
                    </ul>
                </li>
                <li>
                    <a href="#" class="has-arrow">
                        <i class="fas fa-folder"></i>
                        <span class="menu-text">Categorías</span>
                    </a>
                    <ul>
                        <li><a href="#"><i class="fas fa-laptop"></i> Hardware</a></li>
                        <li><a href="#"><i class="fas fa-code"></i> Software</a></li>
                        <li><a href="#"><i class="fas fa-network-wired"></i> Redes</a></li>
                        <li><a href="#"><i class="fas fa-database"></i> Base de Datos</a></li>
                    </ul>
                </li>
                <li>
                    <a href="#">
                        <i class="fas fa-calendar-alt"></i>
                        <span class="menu-text">Calendario</span>
                    </a>
                </li>
                <li>
                    <a href="#">
                        <i class="fas fa-video"></i>
                        <span class="menu-text">Videos Tutoriales</span>
                    </a>
                </li>
                <li>
                    <a href="#">
                        <i class="fas fa-chart-bar"></i>
                        <span class="menu-text">Reportes</span>
                    </a>
                </li>
                <li>
                    <a href="#" class="has-arrow">
                        <i class="fas fa-cog"></i>
                        <span class="menu-text">Configuración</span>
                    </a>
                    <ul>
                        <li><a href="#"><i class="fas fa-sliders-h"></i> General</a></li>
                        <li><a href="#"><i class="fas fa-bell"></i> Notificaciones</a></li>
                        <li><a href="#"><i class="fas fa-shield-alt"></i> Seguridad</a></li>
                    </ul>
                </li>
            </ul>
        </nav>

        <!-- ========================================= -->
        <!-- CONTENIDO PRINCIPAL -->
        <!-- ========================================= -->
        <div id="content">
            <!-- Navbar superior con usuario autenticado a la derecha -->
            <nav class="navbar-top">
                <button type="button" id="sidebarCollapse" class="menu-toggle">
                    <i class="fas fa-bars"></i>
                </button>

                <div class="user-menu">
                    <div class="user-details">
                        <div class="user-name">Juan Pérez Hernández</div>
                        <div class="user-role">Agente de Soporte Nivel 2</div>
                    </div>
                    <div class="user-avatar">
                        JP
                    </div>
                    <div class="dropdown">
                        <button class="btn btn-light dropdown-toggle" type="button" data-bs-toggle="dropdown">
                            <i class="fas fa-chevron-down"></i>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li><a class="dropdown-item" href="#"><i class="fas fa-user me-2"></i> Perfil</a></li>
                            <li><a class="dropdown-item" href="#"><i class="fas fa-cog me-2"></i> Configuración</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li><a class="dropdown-item" href="#"><i class="fas fa-sign-out-alt me-2"></i> Cerrar Sesión</a></li>
                        </ul>
                    </div>
                </div>
            </nav>

            <!-- Contenido principal -->
            <div class="main-content">
                @RenderBody()
            </div>
        </div>
    </div>

    <!-- ========================================= -->
    <!-- SCRIPTS -->
    <!-- ========================================= -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/fullcalendar@5.11.3/main.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@3.9.1/dist/chart.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <!-- ========================================= -->
    <!-- SCRIPT PARA EL CALENDARIO Y GRÁFICAS -->
    <!-- ========================================= -->
    <script src="~/Scripts/Comun/Calendario.js"></script>
</body>
</html>