@model ServiceDeskDESIEntities.Autenticacion.Usuario
@{
    ViewBag.Title = "Mi Perfil";
    Layout = "~/Views/Shared/_Layout.cshtml";
    
}

<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.1/jquery.validate.min.js"></script>

<div class="form-section">
    @if (ViewBag.ErrorMessage != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-circle"></i> @ViewBag.ErrorMessage
            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                <span aria-hidden="true">&times;</span>
            </button>
        </div>
    }

    <h3 class="section-title"><i class="fas fa-user-circle me-2"></i>Mi Perfil</h3>

    <form enctype="multipart/form-data" id="frmPerfil" name="frmPerfil" method="post">
        @Html.HiddenFor(x => x.Id)
        @Html.HiddenFor(x => x.CreadoPor)
        @Html.HiddenFor(x => x.FechaCreacion)
        @Html.HiddenFor(x => x.ModificadoPor)
        @Html.HiddenFor(x => x.FechaModificacion)
        @Html.HiddenFor(x => x.Estatus)
        @Html.HiddenFor(x => x.Contrasena)
        @Html.HiddenFor(x => x.EmpresaId)

        <div class="row">
            <div class="col-md-6">
                <div class="mb-3">
                    <label>Nombre de usuario:</label>
                    @Html.TextBoxFor(x => x.NombreUsuario, new { @class = "form-control", placeholder = "Nombre de usuario", @readonly = "readonly", @disabled = "disabled" })
                </div>
            </div>
            <div class="col-md-6">
                <div class="mb-3">
                    <label>Correo electrónico:</label>
                    @Html.TextBoxFor(x => x.Correo, new { @class = "form-control", placeholder = "Correo electrónico", @disabled = "disabled" })
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-6">
                <div class="mb-3">
                    <label>Nombre(s):</label>
                    @Html.TextBoxFor(x => x.Nombre, new { @class = "form-control", placeholder = "Nombre(s)" })
                </div>
            </div>
            <div class="col-md-6">
                <div class="mb-3">
                    <label>Apellidos:</label>
                    @Html.TextBoxFor(x => x.Apellido, new { @class = "form-control", placeholder = "Apellidos" })
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-6">
                <div class="mb-3">
                    <label>Teléfono celular:</label>
                    @Html.TextBoxFor(x => x.Celular, new { @class = "form-control", placeholder = "Teléfono celular" })
                </div>
            </div>
            <div class="col-md-6">
                <div class="mb-3">
                    <label>RFC:</label>
                    @Html.TextBoxFor(x => x.RFC, new { @class = "form-control", placeholder = "RFC" })
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-6">
                <div class="mb-3">
                    <label>Sucursal:</label>
                    @Html.DropDownListFor(x => x.SucursalId, new SelectList(ViewBag.Sucursales, "Id", "Nombre"), "Seleccione una sucursal", new { @class = "form-control" })
                </div>
            </div>
            <div class="col-md-6">
                <div class="mb-3">
                    <label>Área:</label>
                    @Html.DropDownListFor(x => x.AreaId, new SelectList(ViewBag.Areas, "Id", "Nombre"), "Seleccione un área", new { @class = "form-control" })
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-12">
                <div class="mb-3">
                    <label>Imagen de perfil:</label>
                    <div class="d-flex align-items-center gap-3">
                        @if (!string.IsNullOrEmpty(Model.ImagenPerfil))
                        {
                            <img src="@Model.ImagenPerfil" alt="Foto de perfil" class="rounded-circle" style="width: 80px; height: 80px; object-fit: cover;" id="imgPerfil" />
                        }
                        @*else
                        {
                            <div id="avatarIniciales" class="rounded-circle d-flex align-items-center justify-content-center bg-primary text-white" style="width: 80px; height: 80px; font-size: 2rem; font-weight: bold;">
                                @{
                                    var iniciales = GenerarAvatarIniciales(Model.NombreUsuario);
                                }
                                @iniciales
                            </div>
                        }*@
                        <input type="file" class="form-control" id="ImagenPerfil" name="ImagenPerfil" accept="image/*" />
                    </div>
                    <small class="text-muted">Formatos permitidos: JPG, PNG. Tamaño máximo: 2MB</small>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-12">
                <div class="mb-3">
                    <input type="button" value="Guardar cambios" class="btn btn-success" onclick="GuardarPerfil()" />
                    <a href="/Home/Index" class="btn btn-warning">Cancelar</a>
                </div>
            </div>
        </div>
    </form>
</div>

<script>
    var perfilTemp = '@Model.ImagenPerfil';
</script>
<script src="@Url.Content("~/Scripts/User/MyProfile.js")"></script>