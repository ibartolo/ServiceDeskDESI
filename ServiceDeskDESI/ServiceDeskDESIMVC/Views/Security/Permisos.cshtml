@{
    ViewBag.Title = "Permisos por Rol";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var permisos = ViewBag.Permisos as PermisosViewModel;
}

@{
    var roles = ViewBag.Roles as List<ServiceDeskDESIEntities.Seguridad.Rol>;
    var paginas = ViewBag.Paginas as List<ServiceDeskDESIEntities.Seguridad.Pagina>;
}

<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.1/jquery.validate.min.js"></script>
<script src="https://cdn.datatables.net/2.3.7/js/dataTables.js"></script>
<link href="https://cdn.datatables.net/2.3.7/css/dataTables.dataTables.css" rel="stylesheet" />

<style>
    .chooser-container {
        display: flex;
        gap: 20px;
        margin: 20px 0;
    }

    .chooser-column {
        flex: 1;
        border: 1px solid #e3e6f0;
        border-radius: 8px;
        padding: 15px;
        min-height: 400px;
        max-height: 550px;
        overflow-y: auto;
        background: #f8f9fc;
    }

        .chooser-column h5 {
            font-weight: 600;
            color: #4e73df;
            border-bottom: 2px solid #4e73df;
            padding-bottom: 10px;
            margin-bottom: 15px;
        }

    .chooser-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 10px 12px;
        margin-bottom: 8px;
        background: white;
        border-radius: 6px;
        border: 1px solid #e3e6f0;
        cursor: pointer;
        transition: all 0.2s;
    }

        .chooser-item:hover {
            border-color: #4e73df;
            box-shadow: 0 2px 8px rgba(78, 115, 223, 0.15);
        }

        .chooser-item .item-actions {
            display: flex;
            gap: 8px;
            align-items: center;
        }

        .chooser-item .permisos-checkboxes {
            display: flex;
            gap: 12px;
            font-size: 0.8rem;
            flex-wrap: wrap;
        }

            .chooser-item .permisos-checkboxes label {
                margin-bottom: 0;
                font-weight: 400;
                cursor: pointer;
            }

            .chooser-item .permisos-checkboxes input[type="checkbox"] {
                margin-right: 3px;
                cursor: pointer;
            }

    .btn-move {
        background: #4e73df;
        color: white;
        border: none;
        border-radius: 50%;
        width: 28px;
        height: 28px;
        font-size: 14px;
        cursor: pointer;
        transition: all 0.2s;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

        .btn-move:hover {
            background: #2e59d9;
            transform: scale(1.05);
        }

    .btn-move-danger {
        background: #e74a3b;
    }

        .btn-move-danger:hover {
            background: #c0392b;
        }

    .badge-paginas {
        background: #4e73df;
        color: white;
        border-radius: 20px;
        padding: 2px 12px;
        font-size: 0.75rem;
    }

    .empty-message {
        color: #858796;
        text-align: center;
        padding: 40px 0;
        font-style: italic;
    }

    .chooser-item .item-info {
        display: flex;
        flex-direction: column;
        flex: 1;
    }

        .chooser-item .item-info .item-nombre {
            font-weight: 500;
            color: #5a5c69;
        }

        .chooser-item .item-info .item-direccion {
            font-size: 0.75rem;
            color: #858796;
        }

    .chooser-item.asignada {
        border-left: 3px solid #4e73df;
    }

    .chooser-item.disponible {
        border-left: 3px solid #858796;
    }

    .text-muted-small {
        font-size: 0.8rem;
        color: #858796;
    }

    .filtro-container {
        margin-bottom: 15px;
    }
</style>

<div class="form-section">
    <h3 class="section-title"><i class="fas fa-lock me-2"></i>Asignación de Permisos por Rol</h3>

    <!-- 1. Selección de Rol -->
    <div class="row">
        <div class="col-md-6">
            <div class="mb-3">
                <label>Seleccionar Rol:</label>
                <select id="ddlRol" class="form-control">
                    <option value="">-- Seleccione un rol --</option>
                    @if (roles != null)
                    {
                        foreach (var rol in roles)
                        {
                            <option value="@rol.Id">@rol.Nombre</option>
                        }
                    }
                </select>
            </div>
        </div>
        <div class="col-md-6">
            <div class="mb-3 text-end" style="padding-top: 20px;">
                <button type="button" class="btn btn-success" id="btnGuardarPermisos" style="display:none;">
                    <i class="fas fa-save"></i> Guardar Cambios
                </button>
            </div>
        </div>
    </div>

    <!-- 2. Chooser de Páginas -->
    <div id="chooserContainer" style="display:none;">
        <!-- Input de búsqueda para filtrar páginas -->
        <div class="row filtro-container">
            <div class="col-md-12">
                <div class="input-group">
                    <span class="input-group-text"><i class="fas fa-search"></i></span>
                    <input type="text" class="form-control" id="filtroPaginas" placeholder="Buscar página por nombre...">
                    <button class="btn btn-outline-secondary" type="button" id="btnLimpiarFiltro">
                        <i class="fas fa-times"></i>
                    </button>
                </div>
            </div>
        </div>

        <div class="chooser-container">
            <!-- Columna Izquierda: Páginas Disponibles -->
            <div class="chooser-column">
                <h5><i class="fas fa-list me-2"></i>Páginas Disponibles</h5>
                <div id="paginasDisponibles">
                    <div class="empty-message">Seleccione un rol para cargar las páginas</div>
                </div>
            </div>

            <!-- Columna Derecha: Páginas Asignadas -->
            <div class="chooser-column">
                <h5><i class="fas fa-check-circle me-2"></i>Páginas Asignadas</h5>
                <div id="paginasAsignadas">
                    <div class="empty-message">No hay páginas asignadas a este rol</div>
                </div>
            </div>
        </div>
    </div>

    <!-- 3. Tabla de Roles (Resumen) -->
    <div class="row mt-4">
        <div class="col-md-12">
            <h5 class="section-title"><i class="fas fa-table me-2"></i>Resumen de Roles</h5>
            <div class="table-responsive">
                <table id="tblRoles" class="table table-striped">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Nombre</th>
                            <th>Descripción</th>
                            <th>Páginas Asignadas</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<script>
    // Pasar permisos a JavaScript
    var permisosGlobal = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(permisos));

    // Obtener todas las páginas desde ViewBag.Paginas
    @if (paginas != null)
    {
        <text>var todasLasPaginas = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(paginas));</text>
    }
    else
    {
        <text>var todasLasPaginas = [];</text>
    }
</script>
<script src="@Url.Content("~/Scripts/Security/Permisos.js")"></script>