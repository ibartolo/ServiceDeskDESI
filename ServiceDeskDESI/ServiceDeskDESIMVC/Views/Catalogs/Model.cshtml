@model ServiceDeskDESIEntities.Catalogos.Modelo
    @{
        ViewBag.Title = "Model";
        Layout = "~/Views/Shared/_Layout.cshtml";
    }
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.1/jquery.validate.min.js"></script>
    <script src="https://cdn.datatables.net/2.3.7/js/dataTables.js"></script>
    <link href="https://cdn.datatables.net/2.3.7/css/dataTables.dataTables.css" rel="stylesheet" />
    <div class="form-section">
        @if (ViewBag.ErrorMessage != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="fas fa-exclamation-circle"></i> @ViewBag.ErrorMessage
                <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
         }
        <h3 class="section-title"><i class="fas fa-ticket-alt me-2"></i>Area Modelo</h3>
        <form enctype="multipart/form-data" id="frmModelo" name="frmModelo" method="post">
            @Html.HiddenFor(x => x.Id)
            @Html.HiddenFor(x => x.CreadoPor)
            @Html.HiddenFor(x => x.FechaCreacion)
            @Html.HiddenFor(x => x.ModificadoPor)
            @Html.HiddenFor(x => x.FechaModificacion)
            @Html.HiddenFor(x => x.Estatus)
            

            <div class="row">
                <div class="cold-md-4">
                    <div class="mb-3">
                        <label>Nombre</label>
                        @Html.TextBoxFor(x => x.Nombre, new { @class = "form-control", placeholder = "Nombre de Modelo" })
                    </div>
                </div>
                <div class="cold-md-4">
                    <div class="mb-3">
                        <label>Descripcion</label>
                        @Html.TextBoxFor(x => x.Descripcion, new { @class = "form-control", placeholder = "Descripcion De Modelo" })
                    </div>
                </div>
            </div>
        </form>
    </div>
