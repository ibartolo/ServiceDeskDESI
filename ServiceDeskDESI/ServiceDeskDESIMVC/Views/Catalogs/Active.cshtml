@model ServiceDeskDESIEntities.Catalogos.Activo
@{
    ViewBag.Title = "Active";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var permisos = ViewBag.Permisos as PermisosViewModel;
}
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.1/jquery.validate.min.js"></script>
<script src="https://cdn.datatables.net/2.3.7/js/dataTables.js"></script>
<link href="https://cdn.datatables.net/2.3.7/css/dataTables.dataTables.css" rel="stylesheet" />

<style>
    .is-invalid-dropdown {
        border-color: #dc3545 !important;
        padding-right: calc(1.5em + 0.75rem) !important;
        background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 12 12' width='12' height='12' fill='none' stroke='%23dc3545'%3e%3ccircle cx='6' cy='6' r='4.5'/%3e%3cpath stroke-linejoin='round' d='M5.8 3.6h.4L6 6.5z'/%3e%3ccircle cx='6' cy='8.2' r='.6' fill='%23dc3545' stroke='none'/%3e%3c/svg%3e") !important;
        background-repeat: no-repeat !important;
        background-position: right calc(0.375em + 0.1875rem) center !important;
        background-size: calc(0.75em + 0.375rem) calc(0.75em + 0.375rem) !important;
    }
</style>

<div class="form-section">
    @if (ViewBag.ErrorMessage != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-circle"></i> @ViewBag.ErrorMessage
            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                <span aria-hidden="true">&times;</span>
            </button>
        </div>
    }

    <h3 class="section-title"><i class="fas fa-laptop me-2"></i>Catálogo de Activos</h3>

    <form enctype="multipart/form-data" id="frmActivo" name="frmActivo" method="post">
        @Html.HiddenFor(x => x.Id)
        @Html.HiddenFor(x => x.CreadoPor)
        @Html.HiddenFor(x => x.FechaCreacion)
        @Html.HiddenFor(x => x.ModificadoPor)
        @Html.HiddenFor(x => x.FechaModificacion)
        @Html.HiddenFor(x => x.Estatus)

        <div class="row">
            <div class="col-md-4">
                <div class="mb-3">
                    <label>Nombre</label>
                    @Html.TextBoxFor(x => x.Nombre, new { @class = "form-control", placeholder = "Laptop DELL" })
                </div>
            </div>
            <div class="col-md-8">
                <div class="mb-3">
                    <label>Descripción</label>
                    @Html.TextBoxFor(x => x.Descripcion, new { @class = "form-control", placeholder = "Descripción Activo" })
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-4">
                <div class="mb-3">
                    <label>No. Serial</label>
                    @Html.TextBoxFor(x => x.Serial, new { @class = "form-control", placeholder = "5CD2154XYZ" })
                </div>
            </div>
            <div class="col-md-4">
                <div class="mb-3">
                    <label>Serie interna</label>
                    @Html.TextBoxFor(x => x.SerieLocal, new { @class = "form-control", placeholder = "LAP-CDMX-0002" })
                </div>
            </div>
            <div class="col-md-4">
                <div class="mb-3">
                    <label>Fecha de Compra</label>
                    @Html.TextBoxFor(x => x.FechaCompra, new { @class = "form-control", type = "date", @Value = Model.Id == 0 ? "" : (Model.FechaCompra?.ToString("yyyy-MM-dd") ?? "") })
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-4">
                <div class="mb-3">
                    <label>Tipo de Activo</label>
                    @Html.DropDownListFor(x => x.TipoActivoId, (IEnumerable<SelectListItem>)ViewBag.TipoActivoss, "Seleccione un tipo", new { @class = "form-control", id = "ddlTipoActivo" })
                </div>
            </div>
            <div class="col-md-4">
                <div class="mb-3">
                    <label>Marca</label>
                    <select id="ddlMarca" class="form-control">
                        <option value="">Seleccione una marca</option>
                        @if (ViewBag.Marcass != null)
                        {
                            foreach (var item in (List<SelectListItem>)ViewBag.Marcass)
                            {
                                <option value="@item.Value">@item.Text</option>
                            }
                        }
                    </select>
                    @Html.HiddenFor(x => x.MarcaId)
                </div>
            </div>
            <div class="col-md-4">
                <div class="mb-3">
                    <label>Modelo</label>
                    <select id="ddlModelo" class="form-control">
                        <option value="">Seleccione un modelo</option>
                    </select>
                    @Html.HiddenFor(x => x.ModeloId)
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-4">
                <div class="mb-3">
                    <label>Notas</label>
                    @Html.TextAreaFor(x => x.Notas, new { @class = "form-control", placeholder = "Notas de Activo", rows = 3 })
                </div>
            </div>
        </div>


        <div class="row">
            <div class="col-md-12">
                <div class="mb-3">
                    @if (permisos != null && ((Model.Id == 0 && permisos.PuedeCrear) || (Model.Id > 0 && permisos.PuedeEditar)))
                    {
                        <input type="button" value="Guardar" class="btn btn-success" onclick="GuardarActualizarActivo()" />
                    }
                    <a href="/Catalogs/Active" class="btn btn-warning">Cancelar</a>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-12 table-responsive">
                <div class="mb-3">
                    <table id="tblActivo" class="table table-striped">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Nombre</th>
                                <th>Descripción</th>
                                <th>Serial</th>
                                <th>Marca</th>
                                <th>Modelo</th>
                                <th>Tipo</th>
                                <th>Asignado a</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </form>
    @Html.Partial("_MantenimientoActivo")
</div>

@* Datos de Razor expuestos a JavaScript (deben declararse antes del script externo) *@
<script>
    // Pasar permisos a JavaScript para controlar los botones en el DataTable
    var permisosGlobal = @Html.Raw(JsonConvert.SerializeObject(permisos));
    var tipoActivoSelect = @(Model.TipoActivoId ?? 0);
    var marcaSelect = @(Model.MarcaId ?? 0);
    var modeloSelect = @(Model.ModeloId ?? 0);
    var activoId = @Model.Id;
</script>
<script src="@Url.Content("~/Scripts/Catalogs/Active.js")"></script>
