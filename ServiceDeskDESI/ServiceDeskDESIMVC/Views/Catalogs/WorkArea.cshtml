@model ServiceDeskDESIEntities.Catalogos.Area
@{
    ViewBag.Title = "Area";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var permisos = ViewBag.Permisos as ServiceDeskDESIEntities.Seguridad.PermisosViewModel;
}

<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.1/jquery.validate.min.js"></script>
<script src="https://cdn.datatables.net/2.3.7/js/dataTables.js"></script>
<link href="https://cdn.datatables.net/2.3.7/css/dataTables.dataTables.css" rel="stylesheet" />

<div class="form-section">
    @if (ViewBag.ErrorMessage != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-circle"></i> @ViewBag.ErrorMessage
            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                <span aria-hidden="true">&times;</span>
            </button>
        </div>
    }
    <h3 class="section-title"><i class="fas fa-ticket-alt me-2"></i>Areas de trabajo</h3>
    <form enctype="multipart/form-data" id="frmArea" name="frmArea" method="post">
        @Html.HiddenFor(x => x.Id)
        @Html.HiddenFor(x => x.CreadoPor)
        @Html.HiddenFor(x => x.FechaCreacion)
        @Html.HiddenFor(x => x.ModificadoPor)
        @Html.HiddenFor(x => x.FechaModificacion)
        @Html.HiddenFor(x => x.Estatus)

        <div class="row">
            <div class="col-md-4">
                <div class="mb-3">
                    <label>Nombre:</label>
                    @Html.TextBoxFor(x => x.Nombre, new { @class = "form-control", placeholder = "Nombre del área" })
                </div>
            </div>
            <div class="col-md-4">
                <div class="mb-3">
                    <label>Descripción:</label>
                    @Html.TextBoxFor(x => x.Descripcion, new { @class = "form-control", placeholder = "Descripción del área" })
                </div>
            </div>
            <div class="col-md-4">
                <div class="mb-3">
                    <label>Correo:</label>
                    @Html.TextBoxFor(x => x.Correo, new { @class = "form-control", placeholder = "Correo del área" })
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-md-4">
                <div class="mb-3">
                    <label>Responsable del área:</label>
                    <select id="ddlUsuarioResponsable" class="form-control">
                        <option value="">-- Seleccione un responsable --</option>
                        @if (ViewBag.UsuariosQuePuedenAtender != null)
                        {
                            foreach (var usuario in (List<ServiceDeskDESIEntities.Autenticacion.UsuarioDTO>)ViewBag.UsuariosQuePuedenAtender)
                            {
                                <option value="@usuario.Id" @(Model.UsuarioResponsableId == usuario.Id ? "selected" : "")>@usuario.Nombre @usuario.Apellido (@usuario.NombreUsuario)</option>
                            }
                        }
                    </select>
                    @Html.HiddenFor(x => x.UsuarioResponsableId)
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-md-12">
                <div class="mb-3">
                    @if (permisos != null && (
                        (Model.Id == 0 && permisos.PuedeCrear) ||
                        (Model.Id > 0 && permisos.PuedeEditar)
                    ))
                    {
                        <input type="button" value="Guardar" class="btn btn-success" onclick="GuardarActualizarArea()" />
                    }
                    <a href="/Catalogs/WorkArea" class="btn btn-warning">Cancelar</a>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-md-12 table-responsive">
                <div class="mb-3">
                    <table id="tblArea">
                    </table>
                </div>
            </div>
        </div>
    </form>
</div>

<script>
    // Pasar permisos a JavaScript para controlar los botones en el DataTable
    var permisosGlobal = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(permisos));
</script>
<script src="@Url.Content("~/Scripts/Catalogs/WorkArea.js")"></script>