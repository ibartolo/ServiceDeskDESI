@model ServiceDeskDESIEntities.Catalogos.Sucursal
@{
    ViewBag.Title = "Sucursal";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var permisos = ViewBag.Permisos as PermisosViewModel;
}

<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.1/jquery.validate.min.js"></script>
<script src="https://cdn.datatables.net/2.3.7/js/dataTables.js"></script>
<link href="https://cdn.datatables.net/2.3.7/css/dataTables.dataTables.css" rel="stylesheet" />

<div class="form-section">
    @if (ViewBag.ErrorMessage != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-circle"></i> @ViewBag.ErrorMessage
            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                <span aria-hidden="true">&times;</span>
            </button>
        </div>
    }

    <h3 class="section-title"><i class="fas fa-store me-2"></i>Catálogo de Sucursales</h3>

    <form id="frmSucursal" name="frmSucursal" method="post">
        @Html.HiddenFor(x => x.Id)
        @Html.HiddenFor(x => x.CreadoPor)
        @Html.HiddenFor(x => x.FechaCreacion)
        @Html.HiddenFor(x => x.ModificadoPor)
        @Html.HiddenFor(x => x.FechaModificacion)
        @Html.HiddenFor(x => x.Estatus)

        <div class="row">
            <div class="col-md-4">
                <div class="mb-3">
                    <label>Nombre</label>
                    @Html.TextBoxFor(x => x.Nombre, new { @class = "form-control", placeholder = "Nombre de la sucursal" })
                </div>
            </div>
            <div class="col-md-8">
                <div class="mb-3">
                    <label>Descripción</label>
                    @Html.TextBoxFor(x => x.Descripcion, new { @class = "form-control", placeholder = "Descripción de la sucursal" })
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-4">
                <div class="mb-3">
                    <label>Calle y Número</label>
                    @Html.TextBoxFor(x => x.Calle, new { @class = "form-control", placeholder = "Calle y número" })
                </div>
            </div>
            <div class="col-md-4">
                <div class="mb-3">
                    <label>Ciudad</label>
                    @Html.TextBoxFor(x => x.Ciudad, new { @class = "form-control", placeholder = "Ciudad" })
                </div>
            </div>
            <div class="col-md-4">
                <div class="mb-3">
                    <label>Colonia</label>
                    @Html.TextBoxFor(x => x.Colonia, new { @class = "form-control", placeholder = "Colonia" })
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-4">
                <div class="mb-3">
                    <label>Código Postal</label>
                    @Html.TextBoxFor(x => x.CodigoPostal, new { @class = "form-control", placeholder = "Código Postal" })
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-12">
                <div class="mb-3">
                    @if (permisos != null && ((Model.Id == 0 && permisos.PuedeCrear) || (Model.Id > 0 && permisos.PuedeEditar)))
                    {
                        <input type="button" value="Guardar" class="btn btn-success" onclick="GuardarActualizarSucursal()" />
                    }
                    <a href="/Catalogs/Branch" class="btn btn-warning">Cancelar</a>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-12 table-responsive">
                <div class="mb-3">
                    <table id="tblSucursal" class="table table-striped">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Nombre</th>
                                <th>Descripción</th>
                                <th>Calle</th>
                                <th>Ciudad</th>
                                <th>Colonia</th>
                                <th>Código Postal</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </form>
</div>

@* Datos de Razor expuestos a JavaScript (deben declararse antes del script externo) *@
<script>
    // Pasar permisos a JavaScript para controlar los botones en el DataTable
    var permisosGlobal = @Html.Raw(JsonConvert.SerializeObject(permisos));
</script>
<script src="@Url.Content("~/Scripts/Catalogs/Branch.js")"></script>
