@model ServiceDeskDESIEntities.Catalogos.Compania
@{
    ViewBag.Title = "Company";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var permisos = ViewBag.Permisos as PermisosViewModel;
}

<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.1/jquery.validate.min.js"></script>
<script src="https://cdn.datatables.net/2.3.7/js/dataTables.js"></script>
<link href="https://cdn.datatables.net/2.3.7/css/dataTables.dataTables.css" rel="stylesheet" />

<div class="form-section">
    @if (ViewBag.ErrorMessage != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-circle"></i> @ViewBag.ErrorMessage
            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                <span aria-hidden="true">&times;</span>
            </button>
        </div>
    }
    <h3 class="section-title"><i class="fas fa-building me-2"></i>Catálogo de Compañías (Razón Social)</h3>
    <form enctype="multipart/form-data" id="frmCompania" name="frmCompania" method="post">
        @Html.HiddenFor(x => x.Id)
        @Html.HiddenFor(x => x.CreadoPor)
        @Html.HiddenFor(x => x.FechaCreacion)
        @Html.HiddenFor(x => x.ModificadoPor)
        @Html.HiddenFor(x => x.FechaModificacion)
        @Html.HiddenFor(x => x.Estatus)

        <div class="row">
            <div class="col-md-4">
                <div class="mb-3">
                    <label>Nombre</label>
                    @Html.TextBoxFor(x => x.Nombre, new { @class = "form-control", placeholder = "Nombre Compañía" })
                </div>
            </div>
            <div class="col-md-4">
                <div class="mb-3">
                    <label>Acrónimo</label>
                    @Html.TextBoxFor(x => x.Acronimo, new { @class = "form-control", placeholder = "Acrónimo" })
                </div>
            </div>
            <div class="col-md-4">
                <div class="mb-3">
                    <label>RFC</label>
                    @Html.TextBoxFor(x => x.RFC, new { @class = "form-control", placeholder = "RFC" })
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-md-12">
                <div class="mb-3">
                    <label>Dirección</label>
                    @Html.TextBoxFor(x => x.Direccion, new { @class = "form-control", placeholder = "Dirección" })
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-md-12">
                <div class="mb-3">
                    @if (permisos != null && ((Model.Id == 0 && permisos.PuedeCrear) || (Model.Id > 0 && permisos.PuedeEditar)))
                    {
                        <input type="button" value="Guardar" class="btn btn-success" onclick="GuardarActualizarCompania()" />
                    }
                    <a href="/Catalogs/Company" class="btn btn-warning">Cancelar</a>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-md-12 table-responsive">
                <div class="mb-3">
                    <table id="tblCompania"></table>
                </div>
            </div>
        </div>
    </form>
</div>

<script>
    // Pasar permisos a JavaScript para controlar los botones en el DataTable
    var permisosGlobal = @Html.Raw(JsonConvert.SerializeObject(permisos));
</script>
<script src="@Url.Content("~/Scripts/Catalogs/Company.js")"></script>