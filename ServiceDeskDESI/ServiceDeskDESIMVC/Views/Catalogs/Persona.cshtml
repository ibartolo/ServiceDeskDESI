@model ServiceDeskDESIEntities.Catalogos.PersonaDTO
@{
    ViewBag.Title = "Persona";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var permisos = ViewBag.Permisos as PermisosViewModel;
    var estaVinculada = Model.UsuarioId.HasValue;
    var bloqueoCampos = estaVinculada || (Model.Id > 0 && !permisos.PuedeEditar);
}
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.1/jquery.validate.min.js"></script>
<script src="https://cdn.datatables.net/2.3.7/js/dataTables.js"></script>
<link href="https://cdn.datatables.net/2.3.7/css/dataTables.dataTables.css" rel="stylesheet" />

<div class="form-section">
    @if (ViewBag.ErrorMessage != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-circle"></i> @ViewBag.ErrorMessage
            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                <span aria-hidden="true">&times;</span>
            </button>
        </div>
    }
    <h3 class="section-title"><i class="fas fa-users me-2"></i>Catálogo de Personas</h3>
    <form enctype="multipart/form-data" id="frmPersona" name="frmPersona" method="post">
        @Html.HiddenFor(x => x.Id)
        @Html.HiddenFor(x => x.CreadoPor)
        @Html.HiddenFor(x => x.FechaCreacion)
        @Html.HiddenFor(x => x.ModificadoPor)
        @Html.HiddenFor(x => x.FechaModificacion)
        @Html.HiddenFor(x => x.Estatus)

        <div class="row">
            <div class="col-md-4">
                <div class="mb-3">
                    <label>Nombre</label>
                    @Html.TextBoxFor(x => x.Nombre, bloqueoCampos ? (object)new { @class = "form-control", placeholder = "Nombre", disabled = "disabled" } : (object)new { @class = "form-control", placeholder = "Nombre" })
                </div>
            </div>
            <div class="col-md-4">
                <div class="mb-3">
                    <label>Apellido</label>
                    @Html.TextBoxFor(x => x.Apellido, bloqueoCampos ? (object)new { @class = "form-control", placeholder = "Apellido", disabled = "disabled" } : (object)new { @class = "form-control", placeholder = "Apellido" })
                </div>
            </div>
            <div class="col-md-4">
                <div class="mb-3">
                    <label>Correo</label>
                    @Html.TextBoxFor(x => x.Correo, bloqueoCampos ? (object)new { @class = "form-control", placeholder = "Correo electrónico", disabled = "disabled" } : (object)new { @class = "form-control", placeholder = "Correo electrónico" })
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-md-4">
                <div class="mb-3">
                    <label>Teléfono</label>
                    @Html.TextBoxFor(x => x.Telefono, bloqueoCampos ? (object)new { @class = "form-control", placeholder = "Teléfono", disabled = "disabled" } : (object)new { @class = "form-control", placeholder = "Teléfono" })
                </div>
            </div>
            <div class="col-md-4">
                <div class="mb-3">
                    <label>Puesto</label>
                    @Html.DropDownListFor(x => x.PuestoId, ViewBag.Puestos as SelectList, "Seleccione un puesto", new { @class = "form-control" })
                </div>
            </div>
            <div class="col-md-4">
                <div class="mb-3">
                    <label>Usuario vinculado</label>
                    <input type="text" id="usuarioVinculado" class="form-control" readonly value="@(Model.NombreUsuarioVinculado ?? "")" placeholder="Sin sincronizar" />
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-md-12">
                <div class="mb-3">
                    @if (permisos != null && ((Model.Id == 0 && permisos.PuedeCrear) || (Model.Id > 0 && permisos.PuedeEditar)))
                    {
                        <input type="button" value="Guardar" class="btn btn-success" onclick="GuardarActualizarPersona()" />
                    }
                    <a href="/Catalogs/Persona" class="btn btn-warning">Cancelar</a>
                    @if (permisos != null && ((Model.Id == 0 && permisos.PuedeCrear) || (Model.Id > 0 && !estaVinculada && permisos.PuedeEditar)))
                    {
                        <button type="button" id="btnSincronizar" class="btn btn-outline-primary" title="Sincronizar con usuario" onclick="AbrirSincronizarUsuario()">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                                <path fill-rule="evenodd" d="M8 3a5 5 0 1 0 4.546 2.914.5.5 0 0 1 .908-.417A6 6 0 1 1 8 2v1z" />
                                <path d="M8 4.466V.534a.25.25 0 0 1 .41-.192l2.36 1.966c.12.1.12.284 0 .384L8.41 4.658A.25.25 0 0 1 8 4.466z" />
                            </svg> Sincronizar con usuario
                        </button>
                    }
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-md-12 table-responsive">
                <div class="mb-3">
                    <table id="tblPersona"></table>
                </div>
            </div>
        </div>
    </form>

    @Html.Partial("_AsignarActivoPersona")
</div>

<!-- Modal: Sincronizar con usuario -->
<div class="modal fade" id="modalSincronizarUsuario" tabindex="-1" aria-labelledby="modalSincronizarUsuarioLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalSincronizarUsuarioLabel"><i class="fas fa-sync-alt me-2"></i>Sincronizar con usuario</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <div class="alert alert-warning">
                    <i class="fas fa-exclamation-triangle me-2"></i>
                    <strong>Advertencia:</strong> Los datos de la persona (Nombre, Apellido, Correo y Teléfono) se sobreescribirán con los datos del usuario seleccionado. El puesto <strong>no</strong> se modificará.
                </div>
                <div class="table-responsive">
                    <table class="table table-striped table-hover" id="tblUsuariosSincronizar">
                        <thead>
                            <tr>
                                <th>Usuario</th>
                                <th>Nombre</th>
                                <th>Apellido</th>
                                <th>Correo</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>

<script>
    var permisosGlobal = @Html.Raw(JsonConvert.SerializeObject(permisos));
    var personaUsuarioId = @(Model.UsuarioId ?? 0);
    var personaIdEdicion = @Model.Id;
    var personaNombreUsuarioVinculado = @Html.Raw(JsonConvert.SerializeObject(Model.NombreUsuarioVinculado ?? ""));
</script>
<script src="@Url.Content("~/Scripts/Catalogs/Persona.js")"></script>
