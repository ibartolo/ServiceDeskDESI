@model ServiceDeskDESIMVC.Models.CategoriaResponsableViewModel
@{
    ViewBag.Title = "Responsables por Categoría";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var permisos = ViewBag.Permisos as PermisosViewModel;
}

<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.1/jquery.validate.min.js"></script>
<script src="https://cdn.datatables.net/2.3.7/js/dataTables.js"></script>
<link href="https://cdn.datatables.net/2.3.7/css/dataTables.dataTables.css" rel="stylesheet" />

<style>
    .chooser-container {
        display: flex;
        gap: 20px;
        margin: 20px 0;
    }

    .chooser-column {
        flex: 1;
        border: 1px solid #e3e6f0;
        border-radius: 8px;
        padding: 15px;
        min-height: 400px;
        max-height: 550px;
        overflow-y: auto;
        background: #f8f9fc;
    }

        .chooser-column h5 {
            font-weight: 600;
            color: #4e73df;
            border-bottom: 2px solid #4e73df;
            padding-bottom: 10px;
            margin-bottom: 15px;
        }

    .chooser-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 10px 12px;
        margin-bottom: 8px;
        background: white;
        border-radius: 6px;
        border: 1px solid #e3e6f0;
        cursor: pointer;
        transition: all 0.2s;
    }

        .chooser-item:hover {
            border-color: #4e73df;
            box-shadow: 0 2px 8px rgba(78, 115, 223, 0.15);
        }

        .chooser-item .item-actions {
            display: flex;
            gap: 8px;
            align-items: center;
        }

    .btn-move {
        background: #4e73df;
        color: white;
        border: none;
        border-radius: 50%;
        width: 28px;
        height: 28px;
        font-size: 14px;
        cursor: pointer;
        transition: all 0.2s;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

        .btn-move:hover {
            background: #2e59d9;
            transform: scale(1.05);
        }

    .btn-move-danger {
        background: #e74a3b;
    }

        .btn-move-danger:hover {
            background: #c0392b;
        }

    .empty-message {
        color: #858796;
        text-align: center;
        padding: 40px 0;
        font-style: italic;
    }

    .chooser-item .item-info {
        display: flex;
        flex-direction: column;
        flex: 1;
    }

        .chooser-item .item-info .item-nombre {
            font-weight: 500;
            color: #5a5c69;
        }

        .chooser-item .item-info .item-direccion {
            font-size: 0.75rem;
            color: #858796;
        }

    .chooser-item.asignada {
        border-left: 3px solid #4e73df;
    }

    .chooser-item.disponible {
        border-left: 3px solid #858796;
    }

    .text-muted-small {
        font-size: 0.8rem;
        color: #858796;
    }

    .filtro-container {
        margin-bottom: 15px;
    }

    .badge-principal {
        background: #f6c23e;
        color: #856404;
        padding: 2px 10px;
        border-radius: 12px;
        font-size: 0.7rem;
        font-weight: 600;
    }
</style>

<div class="form-section">
    <h3 class="section-title"><i class="fas fa-user-cog me-2"></i>Responsables por Categoría</h3>

    <!-- Información de la Categoría -->
    @if (Model.Categoria != null)
    {
        <div class="alert alert-info">
            <strong><i class="fas fa-folder-tree me-2"></i>Categoría:</strong> @Model.Categoria.Nombre
            @if (!string.IsNullOrEmpty(Model.Categoria.Descripcion))
            {
                <span class="text-muted"> - @Model.Categoria.Descripcion</span>
            }
            <br />
            <strong><i class="fas fa-chart-simple me-2"></i>Área:</strong> @Model.Categoria.AreaNombre
        </div>
    }

    <!-- 1. Selección de Categoría -->
    <div class="row">
        <div class="col-md-6">
            <div class="mb-3">
                <label>Seleccionar Categoría:</label>
                <select id="ddlCategoria" class="form-control">
                    <option value="">-- Seleccione una categoría --</option>
                    @if (ViewBag.Categorias != null)
                    {
                        var categorias = (List<ServiceDeskDESIEntities.Catalogos.Categoria>)ViewBag.Categorias;
                        foreach (var categoria in categorias)
                        {
                            <option value="@categoria.Id" @(Model.CategoriaId == categoria.Id ? "selected" : "")>@categoria.Nombre</option>
                        }
                    }
                </select>
            </div>
        </div>
        <div class="col-md-6">
            <div class="mb-3 text-end" style="padding-top: 20px;">
                @if (permisos != null && permisos.PuedeCrear)
                {
                    <button type="button" class="btn btn-success" id="btnGuardarResponsables" style="display:none;">
                        <i class="fas fa-save"></i> Guardar Cambios
                    </button>
                }
            </div>
        </div>
    </div>

    <!-- 2. Chooser de Responsables -->
    <div id="chooserContainer" style="display:none;">
        <div class="row filtro-container">
            <div class="col-md-12">
                <div class="input-group">
                    <span class="input-group-text"><i class="fas fa-search"></i></span>
                    <input type="text" class="form-control" id="filtroUsuarios" placeholder="Buscar usuario...">
                    <button class="btn btn-outline-secondary" type="button" id="btnLimpiarFiltro">
                        <i class="fas fa-times"></i>
                    </button>
                </div>
            </div>
        </div>

        <div class="chooser-container">
            <!-- Columna Izquierda: Usuarios Disponibles -->
            <div class="chooser-column">
                <h5><i class="fas fa-users me-2"></i>Usuarios Disponibles</h5>
                <div id="usuariosDisponibles">
                    <div class="empty-message">Seleccione una categoría para cargar los usuarios</div>
                </div>
            </div>

            <!-- Columna Derecha: Responsables Asignados -->
            <div class="chooser-column">
                <h5><i class="fas fa-check-circle me-2"></i>Responsables Asignados</h5>
                <div id="responsablesAsignados">
                    <div class="empty-message">No hay responsables asignados a esta categoría</div>
                </div>
            </div>
        </div>
    </div>

    <!-- 3. Tabla de Responsables por Categoría (Resumen) -->
    <div class="row mt-4">
        <div class="col-md-12">
            <h5 class="section-title"><i class="fas fa-table me-2"></i>Resumen de Responsables por Categoría</h5>
            <div class="table-responsive">
                <table id="tblResponsables" class="table table-striped">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Categoría</th>
                            <th>Área</th>
                            <th>Responsable</th>
                            <th>Principal</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@* Datos de Razor expuestos a JavaScript (deben declararse antes del script externo) *@
<script>
    // Pasar permisos a JavaScript
    var permisosGlobal = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(permisos));
</script>
<script src="@Url.Content("~/Scripts/Catalogs/CategoriaResponsable.js")"></script>
